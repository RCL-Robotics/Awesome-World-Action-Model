---
import { config } from '../lib/project';
import { labels, pathFor, repositoryUrl } from '../../lib/catalog.mjs';
import '../styles/site.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; }
const { title } = Astro.props;
const t = labels(config.language), repo = repositoryUrl(config);
const current = Astro.url.pathname;
---
<!doctype html>
<html lang={config.language} style={`--accent:${config.site.accent}`}>
  <head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={config.description}/><title>{title ? `${title} · ${config.title}` : config.title}</title></head>
  <body>
    <a class="skip" href="#main">{config.language === 'zh' ? '跳至内容' : 'Skip to content'}</a>
    <header class="header shell"><a class="brand" href={pathFor(config)}>{config.title}</a><nav aria-label={config.language === 'zh' ? '主导航' : 'Main navigation'}><a href={pathFor(config)} aria-current={current === pathFor(config) ? 'page' : undefined}>{t.home}</a><a href={pathFor(config, 'papers/')} aria-current={current.includes('/papers') ? 'page' : undefined}>{t.papers}</a>{repo && <a href={repo}>GitHub ↗</a>}</nav></header>
    {config.exampleData && <p class="demo shell">{t.demo}</p>}
    <main id="main" class="shell"><slot/></main>
    <footer class="footer shell"><span>{config.title}</span><span>{config.description}</span></footer>
  </body>
</html>
