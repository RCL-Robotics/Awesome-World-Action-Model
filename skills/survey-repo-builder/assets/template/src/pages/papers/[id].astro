---
import Layout from '../../layouts/Layout.astro';
import { config, papers } from '../../lib/project';
import { dateLabel, labels, pathFor } from '../../../lib/catalog.mjs';
export function getStaticPaths() { return papers.map(paper => ({ params: { id: paper.id }, props: { paper } })); }
const { paper } = Astro.props;
const t = labels(config.language);
---
<Layout title={paper.title}>
  <article class="detail prose"><a class="back" href={pathFor(config, 'papers/')}>← {t.papers}</a><p class="eyebrow">{dateLabel(paper)}</p><h1>{paper.title}</h1><p class="authors">{paper.authors.join('; ')}</p><div class="paper-links"><a href={paper.url}>{t.paper} ↗</a>{paper.codeUrl && <a href={paper.codeUrl}>{t.code} ↗</a>}{paper.projectUrl && <a href={paper.projectUrl}>{t.project} ↗</a>}</div><p class="paper-meta">{paper.categories.map((id: string) => <a href={`${pathFor(config, 'papers/')}?category=${encodeURIComponent(id)}`}>{config.categories.find(c => c.id === id)?.label}</a>)}</p>
    {paper.summary && <section><h2>{t.summary}</h2><p class="preserve-lines">{paper.summary}</p></section>}
    {paper.abstract && <section><h2>{t.abstract}</h2><p class="preserve-lines">{paper.abstract}</p></section>}
    {paper.bibtex && <section><h2>{t.citation}</h2><pre><code>{paper.bibtex}</code></pre></section>}
  </article>
</Layout>
