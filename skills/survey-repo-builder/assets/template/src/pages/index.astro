---
import Layout from '../layouts/Layout.astro';
import { config, papers } from '../lib/project';
import { labels, pathFor, repositoryUrl } from '../../lib/catalog.mjs';
import katex from 'katex';
const t = labels(config.language), repo = repositoryUrl(config);
---
<Layout>
  <section class="hero">
    <p class="eyebrow">{t.introduction}</p>
    <h1>{config.title}</h1><p class="lead">{config.description}</p>
    {config.authors.length > 0 && <p class="authors">{config.authors.map((author, i) => <><span>{author.url ? <a href={author.url}>{author.name}</a> : author.name}{author.affiliation && <small> · {author.affiliation}</small>}</span>{i < config.authors.length - 1 && <span class="separator"> / </span>}</>)}</p>}
    <div class="actions"><a class="button" href={pathFor(config, 'papers/')}>{t.library} →</a>{config.paperUrl && <a class="button secondary" href={config.paperUrl}>{t.paper} ↗</a>}{repo && <a class="text-link" href={repo}>GitHub ↗</a>}</div>
    <p class="collection-meta">{papers.length} {t.count} <span>·</span> {config.categories.length} {t.categories}</p>
  </section>
  <div class="intro-grid"><article class="prose">{config.sections.map(section => <section><h2>{section.heading}</h2><p class="preserve-lines">{section.text}</p>{section.equation && <div class="equation" set:html={katex.renderToString(section.equation, { displayMode: true, throwOnError: true, trust: false })}/>}</section>)}</article><aside class="category-directory"><h2>{t.categories}</h2>{config.categories.map((category, index) => <a href={`${pathFor(config, 'papers/')}?category=${encodeURIComponent(category.id)}`}><span class="category-number">{String(index + 1).padStart(2, '0')}</span><span><strong>{category.label}</strong><small>{category.description}</small></span><span>{papers.filter(p => p.categories.includes(category.id)).length} ↗</span></a>)}</aside></div>
  {config.figures.map(figure => <figure class="survey-figure"><img src={pathFor(config, figure.src)} alt={figure.alt} loading="lazy"/><figcaption>{figure.caption}</figcaption></figure>)}
  <section class="citation prose"><h2>{t.citation}</h2>{config.citation ? <pre><code>{config.citation}</code></pre> : <p>{t.missingCitation}</p>}</section>
  {config.starHistory && repo && <section class="citation prose"><h2>{t.star}</h2><a href={`https://www.star-history.com/#${config.repository!.owner}/${config.repository!.name}&Date`}><img class="star-history" src={`https://api.star-history.com/svg?repos=${config.repository!.owner}/${config.repository!.name}&type=Date`} alt={t.star} loading="lazy"/></a></section>}
</Layout>
