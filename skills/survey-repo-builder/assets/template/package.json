{
  "name": "research-survey-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "validate:data": "node scripts/catalog.mjs validate",
    "generate": "node scripts/generate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check",
    "check:deploy": "node scripts/check-deploy.mjs",
    "build": "npm run validate:data && npm run generate && astro build"
  },
  "dependencies": { "astro": "7.3.1", "katex": "0.18.7" },
  "devDependencies": { "@astrojs/check": "0.9.10", "@types/katex": "0.16.8", "typescript": "5.9.3" }
}
