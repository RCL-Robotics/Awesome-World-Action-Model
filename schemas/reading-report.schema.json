{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reading-report.schema.json",
  "title": "WAM research reading report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "paperId": {
      "type": "string"
    },
    "reportStatus": {
      "type": "string",
      "enum": [
        "full-text-reviewed",
        "partial-text-reviewed",
        "resource-reviewed"
      ]
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "paper",
        "survey",
        "book",
        "dataset",
        "metric",
        "benchmark",
        "simulator",
        "technical-resource"
      ]
    },
    "generatedAt": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pdf",
              "latex",
              "html",
              "text"
            ]
          },
          "sha256": {
            "type": "string"
          },
          "wordCount": {
            "type": "integer",
            "minimum": 0
          },
          "accessedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "kind",
          "sha256",
          "wordCount",
          "accessedAt"
        ]
      },
      "minItems": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "full-paper",
            "selected-sections",
            "abstract-only",
            "resource-overview"
          ]
        },
        "sectionsRead": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identityVerified": {
          "type": "boolean"
        },
        "figuresReviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tablesReviewed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appendix": {
          "type": "string",
          "enum": [
            "reviewed",
            "not-read",
            "not-present",
            "unknown"
          ]
        }
      },
      "required": [
        "scope",
        "sectionsRead",
        "omissions",
        "identityVerified",
        "figuresReviewed",
        "tablesReviewed",
        "appendix"
      ]
    },
    "synopsis": {
      "type": "string"
    },
    "readingTimeMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "author-claim",
            "analysis",
            "open-question"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "text",
        "kind",
        "evidenceIds"
      ]
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "author-claim",
              "analysis",
              "open-question"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "kind",
          "evidenceIds"
        ]
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "detail",
              "evidenceIds"
            ]
          }
        },
        "training": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "source",
                  "author-claim",
                  "analysis",
                  "open-question"
                ]
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "text",
              "kind",
              "evidenceIds"
            ]
          }
        },
        "inference": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "source",
                  "author-claim",
                  "analysis",
                  "open-question"
                ]
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "text",
              "kind",
              "evidenceIds"
            ]
          }
        },
        "equations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expression": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "expression",
              "explanation",
              "evidenceIds"
            ]
          }
        }
      },
      "required": [
        "inputs",
        "outputs",
        "steps",
        "training",
        "inference",
        "equations"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task": {
            "type": "string"
          },
          "setting": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "comparison": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "task",
          "setting",
          "metric",
          "value",
          "comparison",
          "interpretation",
          "evidenceIds"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "author-claim",
              "analysis",
              "open-question"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "kind",
          "evidenceIds"
        ]
      }
    },
    "reproduction": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "author-claim",
              "analysis",
              "open-question"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "kind",
          "evidenceIds"
        ]
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "type": "string",
          "enum": [
            "supports",
            "conflicts",
            "unclear",
            "not-applicable"
          ]
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "source",
                "author-claim",
                "analysis",
                "open-question"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "text",
            "kind",
            "evidenceIds"
          ]
        },
        "recordedClassification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "majorCategory": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "predictionParadigm": {
              "type": "string"
            },
            "quadrant": {
              "type": "string"
            },
            "classificationStatus": {
              "type": "string"
            },
            "catalogUpdatedAt": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            },
            "subcategories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "majorCategory",
            "architecture",
            "predictionParadigm",
            "quadrant",
            "classificationStatus",
            "catalogUpdatedAt",
            "fingerprint",
            "subcategories"
          ]
        }
      },
      "required": [
        "assessment",
        "reasoning",
        "recordedClassification"
      ]
    },
    "discussionQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedPaperIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sourceId",
          "location",
          "detail"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "paperId",
    "reportStatus",
    "resourceType",
    "generatedAt",
    "sources",
    "coverage",
    "synopsis",
    "readingTimeMinutes",
    "problem",
    "contributions",
    "method",
    "results",
    "limitations",
    "reproduction",
    "taxonomy",
    "discussionQuestions",
    "relatedPaperIds",
    "evidence"
  ]
}
