{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "paperId", "outcome", "reason", "evidenceIds", "baseReportPath", "editionPath", "metadataPath"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "paperId": {"type": "string"},
    "outcome": {"type": "string", "enum": ["illustrated", "illustration-unavailable"]},
    "reason": {"type": "string"},
    "evidenceIds": {"type": "array", "items": {"type": "string"}},
    "baseReportPath": {"type": "string", "const": "report.json"},
    "editionPath": {"type": ["string", "null"], "enum": ["edition.json", null]},
    "metadataPath": {"type": "string", "const": "metadata.json"}
  }
}
