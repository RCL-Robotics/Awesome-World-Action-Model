---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FontSizePreference from '../components/FontSizePreference.astro';
import { pathFor, repoUrl, meta } from '../lib/catalog';
interface Props { title?: string; description?: string; active?: string; }
const { title = 'Awesome World Action Model', description = 'Explore a curated collection of world action model research. Browse papers by category, discover ideas, and follow advances in prediction, planning, and control.', active = 'explore' } = Astro.props;
const isNotFound = /\/404\/?$/.test(Astro.url.pathname);
const canonical = new URL(isNotFound ? Astro.url.pathname.replace(/\/404\/?$/, '/404.html') : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-font-size="large">
  <head>
    <meta charset="UTF-8" />
    <FontSizePreference />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" />
    {isNotFound && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <title>{title === 'Awesome World Action Model' ? title : `${title} · Awesome WAM`}</title>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader active={active} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-brand" href={pathFor()}>Awesome World Action Model<span>↗</span></a><p>A community resource for world models and action.</p></div>
      <div class="footer-meta"><a href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noopener noreferrer">Contribute a paper <Icon name="arrow" size={13}/></a><span>Collection updated {new Date(meta.updatedAt).toISOString().slice(0, 10)}</span></div>
    </footer>
  </body>
</html>
