---
import '../styles/global.css';
import '../styles/classic-site.css';
import Icon from '../components/Icon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { pathFor, repoUrl, meta } from '../lib/catalog';
import { siteName, siteShortName } from '../lib/site.mjs';
interface Props { title?: string; description?: string; active?: string; pageClass?: string; }
const { title = siteName, description = 'Explore a curated collection of research on World-Action Models. Browse papers by category, discover ideas, and follow advances in prediction, planning, and control.', active = 'explore', pageClass = '' } = Astro.props;
const isNotFound = /\/404\/?$/.test(Astro.url.pathname);
const canonical = new URL(isNotFound ? Astro.url.pathname.replace(/\/404\/?$/, '/404.html') : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class:list={{ 'survey-home': active === 'home' }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {isNotFound && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <title>{title === siteName ? title : `${title} · ${siteShortName}`}</title>
    <slot name="head" />
  </head>
  <body class:list={['classic-site', pageClass]}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader active={active} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-brand" href={pathFor()}>{siteName}<span>↗</span></a><p>A community resource for World-Action Models.</p></div>
      <div class="footer-meta"><a href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noopener noreferrer">Contribute a paper <Icon name="arrow" size={13}/></a><span>Collection updated {new Date(meta.updatedAt).toISOString().slice(0, 10)}</span></div>
    </footer>
  </body>
</html>
