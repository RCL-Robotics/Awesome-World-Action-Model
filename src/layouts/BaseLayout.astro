---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { pathFor, repoUrl, meta } from '../lib/catalog';
interface Props { title?: string; description?: string; active?: string; }
const { title = 'Awesome World Action Model', description = 'Explore a curated collection of world action model research. Browse papers by category, discover ideas, and follow advances in prediction, planning, and control.', active = 'explore' } = Astro.props;
const isNotFound = /\/404\/?$/.test(Astro.url.pathname);
const canonical = new URL(isNotFound ? Astro.url.pathname.replace(/\/404\/?$/, '/404.html') : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" />
    {isNotFound && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <title>{title === 'Awesome World Action Model' ? title : `${title} · Awesome WAM`}</title>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={pathFor()} aria-label="Awesome World Action Model home">
          <svg viewBox="0 0 36 36" class="brand-mark" fill="none" aria-hidden="true"><path d="m18 3 13 7.5v15L18 33 5 25.5v-15L18 3Z" stroke="currentColor" stroke-width="1.5"/><path d="m5 10.5 13 8 13-8M18 18.5V33M11.5 7l13 7.5v15" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="18.5" r="3" fill="#7fa8ca" stroke="#f8fafc" stroke-width="2"/></svg>
          <span>AWESOME <b>WAM</b><small>WORLD ACTION MODELS</small></span>
        </a>
        <nav aria-label="Main navigation">
          <a class:list={{ active: active === 'explore' }} href={pathFor()}>Explore</a>
          <a class:list={{ active: active === 'map' }} href={pathFor('map/')}>Research map</a>
          <a class:list={{ active: active === 'reports' }} href={pathFor('reports/')}>Reading reports</a>
          <a class:list={{ active: active === 'about' }} href={pathFor('about/')}>About</a>
        </nav>
        <a class="github-link" href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub repository"><Icon name="github" size={17} /><span>GitHub</span><Icon name="arrow" size={14} /></a>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-brand" href={pathFor()}>Awesome World Action Model<span>↗</span></a><p>A community resource for world models and action.</p></div>
      <div class="footer-meta"><a href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noopener noreferrer">Contribute a paper <Icon name="arrow" size={13}/></a><span>Collection updated {new Date(meta.updatedAt).toISOString().slice(0, 10)}</span></div>
    </footer>
  </body>
</html>

<style>
  @media (max-width: 800px) { .header-inner nav { gap: 16px; } .header-inner nav a { font-size: 11px; } }
  @media (max-width: 560px) { .header-inner nav { gap: clamp(12px, 4vw, 24px); } .header-inner nav a { font-size: 10px; } }
</style>
