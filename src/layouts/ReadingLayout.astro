---
import '../styles/global.css';
import '../styles/illustrated-reports.css';
import SiteHeader from '../components/SiteHeader.astro';
import FontSizePreference from '../components/FontSizePreference.astro';
import { pathFor } from '../lib/catalog';
interface Props { title: string; description: string; active?: string; }
const { title, description, active = 'reports' } = Astro.props;
---
<!doctype html>
<html lang="en" class="reading-document" data-font-size="large">
  <head>
    <meta charset="UTF-8"/>
    <FontSizePreference />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#f6f7f3"/>
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')}/>
    <title>{title} · Awesome WAM</title>
  </head>
  <body class="reading-report">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader active={active} />
    <main id="main-content"><slot/></main>
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('.reading-report > .site-header');
  if (header) {
    const updateHeaderHeight = () => document.documentElement.style.setProperty('--reading-header-height', `${header.getBoundingClientRect().height}px`);
    updateHeaderHeight();
    new ResizeObserver(updateHeaderHeight).observe(header);
  }
</script>
