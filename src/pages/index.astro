---
import BaseLayout from '../layouts/BaseLayout.astro';
import SurveyOverview from '../components/SurveyOverview.astro';
import SurveyCitation from '../components/SurveyCitation.astro';
import SurveyTraining from '../components/SurveyTraining.astro';
import SurveyApplications from '../components/SurveyApplications.astro';
import '../styles/survey-home.css';
import { pathFor, repoUrl } from '../lib/catalog';
import { surveyTitle } from '../lib/survey.mjs';
---

<BaseLayout title={surveyTitle} description="A robotics-oriented survey of components, architectures, training, data, and applications of World-Action Models." active="home">
  <script is:inline slot="head" define:vars={{ libraryUrl: pathFor('papers/') }}>
    // Keep bookmarked searches and the former homepage library anchor working.
    {
      const catalogKeys = ['q', 'major', 'quadrant', 'subtype', 'category', 'month', 'year', 'secondary', 'code', 'sort', 'view', 'page'];
      const redirectLegacyLibrary = () => {
        const params = new URLSearchParams(location.search);
        if (location.hash === '#library' || catalogKeys.some(key => params.has(key))) {
          location.replace(`${libraryUrl}${location.search}${location.hash}`);
        }
      };
      redirectLegacyLibrary();
      window.addEventListener('hashchange', redirectLegacyLibrary);
      window.addEventListener('popstate', redirectLegacyLibrary);
    }
  </script>
  <SurveyOverview />
  <SurveyTraining />
  <SurveyApplications />
  <SurveyCitation />
  <aside id="ai-disclosure" class="home-disclosure" aria-label="AI assistance and corrections">
    <p><strong>AI assistance and corrections.</strong> GPT-6 Astra assisted with building this website and reading and summarizing the literature. Errors and omissions may remain. Please report any issues via <a href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noopener noreferrer">GitHub Issues</a>. We will carefully review your feedback and make corrections.</p>
  </aside>
</BaseLayout>
