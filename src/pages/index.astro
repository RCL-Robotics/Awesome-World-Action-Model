---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import WorldDiagram from '../components/WorldDiagram.astro';
import PaperCard from '../components/PaperCard.astro';
import { papers, meta, categories, uncategorizedCategory, pendingCount, repoUrl, pathFor, formatDate } from '../lib/catalog';
const dates = papers.map(p => p.submittedDate).filter((date): date is string => Boolean(date)).sort();
const months = [...new Set(dates.map(date => date.slice(0, 7)))].sort().reverse();
const years = [...new Set(papers.map(p => p.publicationYear).filter((year): year is number => Number.isInteger(year)))].sort((a, b) => b - a);
const earliest = dates[0] || null;
const latest = dates.at(-1) || null;
const rangeLabel = years.length ? `${years.at(-1)}${years.length > 1 ? ` – ${years[0]}` : ''}` : earliest && latest ? `${formatDate(earliest, { month: 'short', year: 'numeric' })} – ${formatDate(latest, { month: 'short', year: 'numeric' })}` : 'Not recorded';
const rangeCaption = years.length ? 'recorded publication years' : 'known submission dates';
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-line"></span> A CURATED RESEARCH COLLECTION <span class="edition">2026 EDITION</span></div>
      <h1>A field guide to<br/><em>world action models.</em></h1>
      <p>Explore the research connecting world prediction to intelligent action. A growing collection of papers across robotics, planning, and embodied AI.</p>
      <div class="hero-actions"><a class="button button-primary" href="#library">Explore the papers <Icon name="right" size={17}/></a><a class="text-link" href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noopener noreferrer">Suggest a paper <Icon name="plus" size={15}/></a></div>
    </div>
    <WorldDiagram/>
  </section>
  <div class="collection-bar shell"><div><strong>{papers.length}</strong><span>research papers</span></div><div><strong>{categories.length.toString().padStart(2, '0')}</strong><span>research directions</span></div><div class="date-stat"><strong>{rangeLabel}</strong><span>{rangeCaption}</span></div><a href={pathFor('map/')}>Discover the research map <Icon name="right" size={16}/></a></div>

  <section class="library shell" id="library" aria-labelledby="library-heading">
    <aside class="catalog-sidebar">
      <div class="sidebar-heading">RESEARCH DIRECTIONS <span>{categories.length.toString().padStart(2, '0')}</span></div>
      <nav class="category-nav" aria-label="Filter by primary category">
        <a href="#library" data-category="" class="selected" aria-current="true"><span><Icon name="grid" size={15}/>All papers</span><b>{papers.length}</b></a>
        {categories.map(category => <a href={`?category=${encodeURIComponent(category.name)}#library`} data-category={category.name}><span><i style={`--category-color:${category.color}`}></i>{category.label}</span><b>{category.count}</b></a>)}
      </nav>
      {pendingCount > 0 && <div class="pending-filter"><div class="sidebar-heading">CURATION STATUS</div><nav class="category-nav" aria-label="Filter papers awaiting classification"><a href={`?category=${uncategorizedCategory.name}#library`} data-category={uncategorizedCategory.name}><span><i style={`--category-color:${uncategorizedCategory.color}`}></i>{uncategorizedCategory.label}</span><b>{pendingCount}</b></a></nav></div>}
      <div class="sidebar-note"><Icon name="book" size={21}/><h3>Find your next direction.</h3><p>Explore how the field connects through geometry, memory, representation, and control.</p><a href={pathFor('map/')}>Browse the map <Icon name="right" size={14}/></a></div>
      <a class="download-link" href={pathFor('papers.json')} download="world-action-model-papers.json">Download collection <Icon name="arrow" size={13}/></a>
    </aside>
    <div class="catalog-main">
      <div class="section-heading"><div><div class="eyebrow small">THE PAPER INDEX</div><h2 id="library-heading">Explore the literature<span>.</span></h2></div><span class="collection-update"><span class="status-dot"></span> Updated {meta.updatedAt.slice(0, 10)}</span></div>
      {pendingCount > 0 && <p class="catalog-coverage"><a href={`?category=${uncategorizedCategory.name}#library`} data-category={uncategorizedCategory.name}>{pendingCount} papers await classification</a>. All records are searchable; some summaries and publication details are still to be added.</p>}
      <form id="catalog-form" class="catalog-tools" role="search">
        <div class="search-box"><Icon name="search" size={21}/><label class="sr-only" for="paper-search">Search papers, authors, abstracts, identifiers, or source URLs</label><input id="paper-search" name="q" type="search" autocomplete="off" placeholder="Search papers, authors, DOI, or an idea…"/><kbd aria-hidden="true">/</kbd></div>
        <div class="filter-row">
          <div class="filter-select"><label for="year-filter">Publication year</label><select id="year-filter" name="year" aria-label="Filter by recorded publication year"><option value="">All publication years</option>{years.map(year => <option value={year}>{year}</option>)}</select></div>
          <div class="filter-select"><label for="month-filter">Submitted</label><select id="month-filter" name="month"><option value="">All months</option>{months.map(month => <option value={month}>{formatDate(`${month}-01`, { month: 'long', year: 'numeric' })}</option>)}</select></div>
          <div class="filter-select secondary-select"><label for="secondary-filter">Also explores</label><select id="secondary-filter" name="secondary"><option value="">Any direction</option>{categories.map(category => <option value={category.name}>{category.label}</option>)}</select></div>
          <label class="code-filter"><input type="checkbox" id="code-filter" name="code"/><span>With code</span></label>
          <button id="reset-filters" class="reset-button" type="button" hidden>Reset filters</button>
        </div>
      </form>
      <noscript><p class="notice">All papers are listed below. Enable JavaScript to search, filter, and paginate the collection.</p></noscript>
      <div class="results-toolbar"><p id="result-count" aria-live="polite" aria-atomic="true"><strong>{papers.length}</strong> papers in the collection</p><div class="results-controls"><label class="sr-only" for="sort-order">Sort papers</label><select id="sort-order"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title A–Z</option></select><span class="toolbar-divider"></span><div class="view-toggle" aria-label="List density"><button class="selected" type="button" data-view="detailed" aria-label="Detailed view" aria-pressed="true"><Icon name="grid" size={16}/></button><button type="button" data-view="compact" aria-label="Compact view" aria-pressed="false"><Icon name="list" size={17}/></button></div></div></div>
      <div id="paper-list" class="paper-list">{papers.map((paper, index) => <PaperCard paper={paper} index={index}/>)}</div>
      <div id="empty-state" class="empty-state" hidden><Icon name="search" size={30}/><h3>No papers found</h3><p>Try another keyword or broaden your filters.</p><button type="button" id="empty-reset" class="button button-secondary">Clear all filters</button></div>
      <nav class="pagination" id="pagination" aria-label="Paper list pages" hidden><span id="page-range"></span><div><button id="previous-page" type="button" aria-label="Previous page">← Previous</button><span id="page-position"></span><button id="next-page" type="button" aria-label="Next page">Next →</button></div></nav>
      <div class="contribute-strip"><div class="contribute-icon"><Icon name="plus" size={20}/></div><div><h3>Help the collection grow.</h3><p>Found a paper that belongs here? Share it with the community.</p></div><a href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noopener noreferrer">Suggest a paper <Icon name="arrow" size={15}/></a></div>
    </div>
  </section>
</BaseLayout>
<script>
  import { papers, categories, uncategorizedCategory } from '../lib/catalog';
  import { filterPapers } from '../lib/search.mjs';
  const PAGE_SIZE = 12;
  const search = document.querySelector<HTMLInputElement>('#paper-search')!;
  const month = document.querySelector<HTMLSelectElement>('#month-filter')!;
  const year = document.querySelector<HTMLSelectElement>('#year-filter')!;
  const secondary = document.querySelector<HTMLSelectElement>('#secondary-filter')!;
  const code = document.querySelector<HTMLInputElement>('#code-filter')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort-order')!;
  const list = document.querySelector<HTMLElement>('#paper-list')!;
  const items = new Map([...list.querySelectorAll<HTMLElement>('[data-paper-id]')].map(item => [item.dataset.paperId!, item]));
  const categoryLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-category]')];
  const reset = document.querySelector<HTMLButtonElement>('#reset-filters')!;
  const previous = document.querySelector<HTMLButtonElement>('#previous-page')!;
  const next = document.querySelector<HTMLButtonElement>('#next-page')!;
  const resultCount = document.querySelector<HTMLElement>('#result-count')!;
  let category = '';
  let page = 1;
  let view = 'detailed';
  let totalPages = 1;

  function readURL() {
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    category = [...categories, uncategorizedCategory].some(c => c.name === params.get('category')) ? params.get('category')! : '';
    month.value = params.get('month') || '';
    year.value = params.get('year') || '';
    secondary.value = params.get('secondary') || '';
    code.checked = params.get('code') === '1';
    sort.value = ['newest', 'oldest', 'title'].includes(params.get('sort') || '') ? params.get('sort')! : 'newest';
    page = Math.max(1, Math.floor(Number(params.get('page')) || 1));
    view = params.get('view') === 'compact' ? 'compact' : 'detailed';
  }

  function render(writeURL = true) {
    const matching = filterPapers(papers, { query: search.value, category, month: month.value, year: year.value, secondary: secondary.value, code: code.checked, sort: sort.value });
    totalPages = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
    page = Math.min(page, totalPages);
    const start = (page - 1) * PAGE_SIZE;
    for (const item of items.values()) item.hidden = true;
    const fragment = document.createDocumentFragment();
    for (const paper of matching.slice(start, start + PAGE_SIZE)) {
      const item = items.get(paper.id)!;
      item.hidden = false;
      fragment.append(item);
    }
    list.append(fragment);
    list.classList.toggle('compact', view === 'compact');
    resultCount.replaceChildren();
    const count = document.createElement('strong');
    count.textContent = String(matching.length);
    resultCount.append(count, ` ${matching.length === 1 ? 'paper' : 'papers'}${matching.length === papers.length ? ' in the collection' : ` of ${papers.length}`}`);
    document.querySelector<HTMLElement>('#empty-state')!.hidden = matching.length > 0;
    document.querySelector<HTMLElement>('#pagination')!.hidden = matching.length <= PAGE_SIZE;
    document.querySelector<HTMLElement>('#page-range')!.textContent = `${start + 1}–${Math.min(start + PAGE_SIZE, matching.length)} of ${matching.length} papers`;
    document.querySelector<HTMLElement>('#page-position')!.textContent = `${page} / ${totalPages}`;
    previous.disabled = page <= 1;
    next.disabled = page >= totalPages;
    reset.hidden = !(search.value || category || month.value || year.value || secondary.value || code.checked);
    categoryLinks.forEach(link => {
      const active = link.dataset.category === category;
      link.classList.toggle('selected', active);
      if (active) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => {
      button.classList.toggle('selected', button.dataset.view === view);
      button.setAttribute('aria-pressed', String(button.dataset.view === view));
    });
    if (writeURL) {
      const params = new URLSearchParams();
      if (search.value) params.set('q', search.value);
      if (category) params.set('category', category);
      if (month.value) params.set('month', month.value);
      if (year.value) params.set('year', year.value);
      if (secondary.value) params.set('secondary', secondary.value);
      if (code.checked) params.set('code', '1');
      if (sort.value !== 'newest') params.set('sort', sort.value);
      if (view !== 'detailed') params.set('view', view);
      if (page > 1) params.set('page', String(page));
      const query = params.toString();
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    }
  }
  function clearFilters() { search.value = ''; month.value = ''; year.value = ''; secondary.value = ''; code.checked = false; category = ''; page = 1; render(); }
  let debounce: ReturnType<typeof setTimeout>;
  search.addEventListener('input', () => { clearTimeout(debounce); debounce = setTimeout(() => { page = 1; render(); }, 120); });
  [month, year, secondary, code, sort].forEach(input => input.addEventListener('change', () => { page = 1; render(); }));
  categoryLinks.forEach(link => link.addEventListener('click', event => { event.preventDefault(); category = link.dataset.category || ''; page = 1; render(); }));
  document.querySelector<HTMLFormElement>('#catalog-form')!.addEventListener('submit', event => { event.preventDefault(); clearTimeout(debounce); page = 1; render(); });
  reset.addEventListener('click', clearFilters);
  document.querySelector('#empty-reset')!.addEventListener('click', clearFilters);
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => button.addEventListener('click', () => { view = button.dataset.view!; render(); }));
  previous.addEventListener('click', () => { page--; render(); document.querySelector('#library')!.scrollIntoView({ behavior: 'auto' }); });
  next.addEventListener('click', () => { page++; render(); document.querySelector('#library')!.scrollIntoView({ behavior: 'auto' }); });
  window.addEventListener('popstate', () => { readURL(); render(false); });
  document.addEventListener('keydown', event => {
    if (event.key === '/' && !event.metaKey && !event.ctrlKey && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement) && !(event.target instanceof HTMLSelectElement)) { event.preventDefault(); search.focus(); }
  });
  readURL(); render(false);
</script>
