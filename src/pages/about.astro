---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { papers, categories, meta, formatDate, pathFor, repoUrl } from '../lib/catalog';
const dates = papers.map(paper => paper.submittedDate).sort();
const firstDate = dates[0];
const lastDate = dates.at(-1);
const collectionStart = firstDate ? formatDate(firstDate, { month: 'long', year: 'numeric' }) : null;
const collectionEnd = lastDate ? formatDate(lastDate, { month: 'long', year: 'numeric' }) : null;
---

<BaseLayout title="About the collection" description="A community resource for discovering world action model research, sharing papers, and exploring connections across the field." active="about">
  <div class="shell about-page">
    <header class="about-header"><span class="eyebrow">ABOUT THE COLLECTION</span><h1>A shared reading list.<br /><span>An evolving field.</span></h1><p>Awesome World Action Model brings research on prediction, planning, and control into one place—so the next useful connection is easier to find.</p></header>

    <div class="about-grid">
      <div class="about-body">
        <section aria-labelledby="scope-heading"><span class="section-number">01 / SCOPE</span><h2 id="scope-heading">Where world models meet action</h2><p>The collection follows models that represent how environments change and how actions shape those changes. It spans spatial and latent representations, memory, multimodal sensing, reinforcement learning, efficient inference, domain applications, and evaluation.</p><p>Browse by research direction, search for an idea or author, or open a paper to read its contribution summary and full abstract. Each entry links to its original arXiv page, with code and project links when available.</p></section>

        <section aria-labelledby="organization-heading"><span class="section-number">02 / ORGANIZATION</span><h2 id="organization-heading">A map for exploring the literature</h2><p>The {categories.length} primary categories offer starting points for reading. Every paper belongs to one primary category; secondary categories make connections across directions visible.</p><p>Paper detail pages preserve the collected title, authors, affiliations, contribution, abstract, submission date, categories, BibTeX key, and source link. Follow the source link to read the paper and obtain its full citation.</p><a class="text-link" href={pathFor('map/')}>Explore the research map <Icon name="right" size={17}/></a></section>

        <section aria-labelledby="contribute-heading"><span class="section-number">03 / CONTRIBUTE</span><h2 id="contribute-heading">Help the collection grow</h2><p>Found a relevant paper or a detail that needs updating? Open an issue on GitHub. A useful submission includes the paper title, arXiv link, suggested category, and a short explanation of how it relates to world action models.</p><p>For corrections, include the paper link and the information to update. Suggestions and contributions can be discussed in the repository.</p><div class="contribution-actions"><a class="button button-primary" href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noopener noreferrer">Suggest a paper <Icon name="plus" size={16}/></a><a class="button button-secondary" href={repoUrl} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16}/> Visit the repository <Icon name="arrow" size={14}/></a></div></section>
      </div>

      <aside class="collection-sidebar" aria-label="Collection overview">
        <div class="collection-card"><span class="eyebrow">THE COLLECTION</span><div class="collection-stat"><strong>{papers.length}</strong><span>research papers</span></div><div class="collection-stat"><strong>{categories.length}</strong><span>research directions</span></div><dl>{collectionStart && collectionEnd && <div><dt>Submission coverage</dt><dd>{collectionStart === collectionEnd ? collectionStart : <>{collectionStart}<br/><span class="coverage-to">to</span> {collectionEnd}</>}</dd></div>}<div><dt>Collection updated</dt><dd><time datetime={meta.updatedAt}>{formatDate(meta.updatedAt.slice(0, 10))}</time></dd></div></dl><a href={`${pathFor()}#library`}>Browse the library <Icon name="right" size={16}/></a></div>
        <p class="sidebar-note">Follow the repository for additions and updates. GitHub Issues require repository access while the repository is private.</p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page { padding-top:65px; padding-bottom:85px; }
  .about-header { max-width:750px; padding-bottom:48px; }
  h1 { color:#1f3c55; font-size:clamp(34px,4.2vw,49px); line-height:1.16; letter-spacing:-1.7px; font-weight:600; margin:19px 0 21px; }
  h1 span { color:#718ba2; }
  .about-header > p { max-width:580px; color:#778593; font-size:14px; line-height:1.9; margin:0; }
  .about-grid { display:grid; grid-template-columns:minmax(0,1fr) 270px; gap:90px; padding-top:37px; border-top:1px solid #e2e8ed; }
  .about-body { max-width:665px; }
  .about-body section + section { margin-top:43px; padding-top:34px; border-top:1px solid #e6ebef; }
  .section-number { font-size:9px; font-weight:500; letter-spacing:1.2px; color:#91a0ad; }
  h2 { color:#2e4a62; font-size:23px; font-weight:600; letter-spacing:-.5px; margin:12px 0 17px; line-height:1.35; }
  .about-body p { color:#74818e; font-size:13px; line-height:1.95; margin:0 0 15px; }
  .text-link { display:inline-flex; gap:8px; align-items:center; color:#496e90; text-decoration:none; font-size:12px; margin-top:3px; }
  .text-link:hover { color:#183e60; }
  .contribution-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; }
  .collection-card { border:1px solid #dfe7ed; border-radius:5px; background:white; padding:26px; }
  .collection-card > .eyebrow { font-size:9px; }
  .collection-stat { display:flex; flex-direction:column; gap:3px; margin-top:21px; }
  .collection-stat strong { font-size:37px; letter-spacing:-1.2px; font-weight:500; line-height:1.1; color:#3f607c; }
  .collection-stat > span { font-size:11px; color:#8795a1; }
  dl { border-top:1px solid #e7edf1; margin:25px 0 0; padding-top:22px; }
  dl > div + div { margin-top:21px; }
  dt { font-size:9px; color:#98a2ad; text-transform:uppercase; letter-spacing:.9px; font-weight:600; margin-bottom:7px; }
  dd { margin:0; font-size:12px; line-height:1.7; color:#61788c; }
  .coverage-to { color:#9aa5af; }
  .collection-card > a { display:flex; align-items:center; justify-content:space-between; color:#60819d; font-size:11px; text-decoration:none; border-top:1px solid #e7edf1; margin-top:24px; padding-top:20px; }
  .sidebar-note { margin:15px 13px 0; font-size:10px; line-height:1.9; color:#98a3ae; }
  @media (max-width:900px) { .about-grid { gap:40px; grid-template-columns:minmax(0,1fr) 240px; }.collection-card { padding:23px; } }
  @media (max-width:650px) { .about-page { padding-top:40px; padding-bottom:55px; }.about-header { padding-bottom:34px; }h1 { letter-spacing:-1px; }.about-grid { grid-template-columns:1fr; padding-top:28px; gap:38px; }.about-body { max-width:none; }h2 { font-size:21px; }.collection-card { display:grid; grid-template-columns:1fr 1fr; gap:0 25px; }.collection-card > .eyebrow,.collection-card dl,.collection-card > a { grid-column:1/-1; }.collection-card dl { display:grid; grid-template-columns:1fr 1fr; gap:20px; }dl > div + div { margin-top:0; } }
</style>
