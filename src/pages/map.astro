---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PaperDate from '../components/PaperDate.astro';
import { categories, papers, classifiedCount, pendingCount, pathFor, paperPath } from '../lib/catalog';
import { MAJOR_CATEGORIES, COMPONENT_AREAS, componentSubcategory, QUADRANTS, QUADRANT_STATUSES, QUADRANT_AXES, taxonomyLabel } from '../lib/taxonomy.mjs';
const total = papers.length;
const libraryLink = (filters: Record<string, string>) => `${pathFor()}?${new URLSearchParams(filters)}#library`;
const majorColors = ['#7e8997', '#6586ab', '#668e7c', '#b29a52', '#9680b1', '#b48862', '#507e86'];
const majorDescriptions = ['Theory, planning, and foundational world-model research', 'Vision, language, and action models', 'World modeling and action generation', 'Resources for training and evaluation', 'Measures and evaluation protocols', 'Tasks, environments, and simulators', 'Reusable encoders, backbones, policies, and learning methods'];
const boardGroups = MAJOR_CATEGORIES.map((name, index) => ({ name, color: majorColors[index], description: majorDescriptions[index], entries: papers.filter(p => p.majorCategory === name) }));
const unmapped = papers.filter(p => !p.majorCategory);
if (unmapped.length) boardGroups.push({ name: 'Unassigned category', color: '#8b96a1', description: 'Major category not yet recorded', entries: unmapped });
const majorValue = (name: string) => MAJOR_CATEGORIES.includes(name) ? name : '__unassigned__';
const subtypesFor = (entries: typeof papers, major: string) => (major === 'WAM Components' ? COMPONENT_AREAS.map(componentSubcategory) : [...new Set(entries.flatMap(p => p.subcategories ?? []))]).map(name => ({ name, count: entries.filter(p => p.subcategories.includes(name)).length })).filter(group => group.count > 0).sort((a, b) => b.count - a.count || taxonomyLabel(a.name).localeCompare(taxonomyLabel(b.name), 'en'));
const quadrants = QUADRANTS.map((name, index) => ({ name, code: `Q${index + 1}`, ...QUADRANT_AXES[name], color: ['#6586ab', '#9680b1', '#668e7c', '#b48862'][index], entries: papers.filter(p => p.quadrant === name) }));
const matrixTotal = quadrants.reduce((sum, quadrant) => sum + quadrant.entries.length, 0);
const outsideGroups = QUADRANT_STATUSES.filter(name => !QUADRANTS.includes(name)).map(name => ({ name, entries: papers.filter(p => p.quadrant === name) }));
const unassignedQuadrants = papers.filter(p => !p.quadrant);
if (unassignedQuadrants.length) outsideGroups.push({ name: 'Unassigned quadrant', entries: unassignedQuadrants });
const outsideDescriptions: Record<string, string> = { '四象限外': 'Classified outside this four-quadrant framework.', '不适用': 'The source marks this framework as not applicable.', '待核实': 'A quadrant assignment has not yet been verified.', 'Unassigned quadrant': 'No quadrant assignment is recorded in the catalog.' };
const modes = [{ id: 'major', label: 'Category board', subtitle: 'Major categories' }, { id: 'quadrants', label: 'Four quadrants', subtitle: 'Architecture × prediction' }, { id: 'topics', label: 'Research topics', subtitle: 'Additional perspectives' }];
---

<BaseLayout title="Category board & four quadrants" description="Browse the collection through recorded major categories, subcategories, and architecture × prediction quadrants." active="map">
  <div class="shell map-page">
    <header class="map-header">
      <div><span class="eyebrow">THE RESEARCH LANDSCAPE</span><h1>Explore the field.<span>Connect the methods.</span></h1><p>Browse by category and subcategory, or compare methods by architecture and prediction paradigm. WAM Components groups reusable building blocks, from visual encoders to action policies. Category labels combine Notion records with local editorial reviews.</p></div>
      <div class="map-summary" aria-label="Classification coverage"><div><strong>{total}</strong><span>references</span></div><div><strong>{MAJOR_CATEGORIES.length}</strong><span>major categories</span></div><div><strong>{matrixTotal}</strong><span>within four quadrants</span></div></div>
    </header>
    <nav class="map-modes" aria-label="Classification views">{modes.map((mode, index) => <a href={`?mode=${mode.id}#classification-view`} data-map-mode={mode.id} class:list={{ selected: index === 0 }} aria-current={index === 0 ? 'page' : undefined}><span>{mode.label}</span><small>{mode.subtitle}</small></a>)}</nav>
    <noscript><p class="map-help">All three classification views are shown below. Enable JavaScript to switch between them.</p><style>.map-panels [data-map-panel][hidden] { display: block !important; margin-top: 42px; }</style></noscript>
    <div class="map-panels" id="classification-view">
      <section data-map-panel="major" aria-labelledby="major-heading">
        <div class="section-intro"><div><span class="eyebrow">FROM FOUNDATIONS TO EVALUATION</span><h2 id="major-heading">Category board</h2></div><p>Scroll each column to explore its references. Expand subcategories or open the index to combine filters.</p></div>
        <div class="major-board">{boardGroups.map(group => <section class="board-column" style={`--group-color:${group.color}`} aria-label={`${taxonomyLabel(group.name)}: ${group.entries.length} references`}>
          <header class="board-heading"><div><h3>{taxonomyLabel(group.name)}</h3><p>{group.description}</p></div><a class="group-count" href={libraryLink({ major: majorValue(group.name) })} aria-label={`${taxonomyLabel(group.name)}, view all ${group.entries.length} references`}>{group.entries.length}<Icon name="arrow" size={13}/></a></header>
          {subtypesFor(group.entries, group.name).length > 0 && <details class="board-subtypes"><summary>{group.name === 'WAM Components' ? 'Component areas' : 'Subcategories'} <span>{subtypesFor(group.entries, group.name).length}</span></summary><div>{subtypesFor(group.entries, group.name).map(subtype => <a href={libraryLink({ major: majorValue(group.name), subtype: subtype.name })}>{taxonomyLabel(subtype.name)}<span>{subtype.count}</span></a>)}</div></details>}
          <ol class="board-list" tabindex="0" aria-label={`${taxonomyLabel(group.name)} references`}>{group.entries.map(paper => <li><div class="board-paper-meta"><PaperDate paper={paper}/>{paper.quadrant?.startsWith('Q') && <span class="mini-quadrant">{paper.quadrant.slice(0, 2)}</span>}{paper.quadrant === '待核实' && <span class="pending-badge">Pending verification</span>}</div><h4><a href={paperPath(paper.id)}>{paper.title}</a></h4><p>{paper.authors}</p></li>)}{!group.entries.length && <li class="board-empty">No references in this category yet.</li>}</ol>
          <a class="board-footer" href={libraryLink({ major: majorValue(group.name) })}>Browse and filter <Icon name="right" size={14}/></a>
        </section>)}</div>
      </section>
      <section data-map-panel="quadrants" aria-labelledby="quadrant-heading" hidden>
        <div class="section-intro"><div><span class="eyebrow">ARCHITECTURE × PREDICTION</span><h2 id="quadrant-heading">Four quadrants</h2></div><p>Rows show architecture; columns show prediction paradigm. Each cell previews four references. Open a count to see all.</p></div>
        <div class="quadrant-key"><span><i></i>Quadrant assignments from Notion</span><span>{matrixTotal} / {total} references in the matrix</span></div>
        <div class="quadrant-matrix" aria-label="Four quadrants: architecture and prediction paradigm">
          <div class="axis-corner"><span>Prediction →</span><span>Architecture ↓</span></div><div class="column-axis"><strong>Joint prediction</strong><span>Future states and actions</span></div><div class="column-axis"><strong>IDM</strong><span>Inverse dynamics</span></div>
          {quadrants.map((quadrant, index) => <>{index % 2 === 0 && <div class="row-axis"><strong>{quadrant.architecture}</strong><span>{index === 0 ? 'Single model' : 'Two systems'}</span></div>}<section class="quadrant-cell" style={`--group-color:${quadrant.color}`} aria-label={taxonomyLabel(quadrant.name)}>
            <header><div><span class="quadrant-code">{quadrant.code}</span><h3>{quadrant.architecture}<span>× {taxonomyLabel(quadrant.predictionParadigm)}</span></h3></div><a class="quadrant-count" href={libraryLink({ quadrant: quadrant.name })} aria-label={`${quadrant.code}, view all ${quadrant.entries.length} references`}><strong>{quadrant.entries.length}</strong><span>refs <Icon name="arrow" size={13}/></span></a></header>
            <ol>{quadrant.entries.slice(0, 4).map(paper => <li><a href={paperPath(paper.id)}>{paper.title}</a></li>)}</ol>{!quadrant.entries.length && <p class="map-help">No references assigned to this quadrant yet.</p>}
            <a class="quadrant-footer" href={libraryLink({ quadrant: quadrant.name })}>View all {quadrant.code} references <Icon name="right" size={14}/></a>
          </section></>)}
        </div>
        <section class="outside-section" aria-labelledby="outside-heading"><div class="section-intro"><h3 id="outside-heading">Beyond the matrix</h3><p>These references retain their separate classification status.</p></div><div class="outside-grid">{outsideGroups.map(group => <a class:list={['outside-card', { pending: group.name === '待核实' }]} href={libraryLink({ quadrant: group.name === 'Unassigned quadrant' ? '__unassigned__' : group.name })}><div><h4>{taxonomyLabel(group.name)}</h4><strong>{group.entries.length}</strong></div><p>{outsideDescriptions[group.name]}</p><span>Browse references <Icon name="right" size={13}/></span></a>)}</div></section>
      </section>
      <section data-map-panel="topics" aria-labelledby="directions-heading" hidden>
        <div class="section-intro"><div><span class="eyebrow">ADDITIONAL RESEARCH TOPICS</span><h2 id="directions-heading">Research topics</h2></div><p>Additional research topics offer another way to explore the collection, alongside major categories and quadrants.</p></div>
        <div class="direction-grid">{categories.map(category => <a class="direction-card" href={libraryLink({ category: category.name })} style={`--group-color:${category.color}`}><div><span class="category-dot" aria-hidden="true"></span><strong>{category.count}</strong></div><h3>{category.label}</h3><p>{category.description}</p><span>Explore topic <Icon name="right" size={14}/></span></a>)}</div>
        <div class="topic-coverage"><p><strong>{classifiedCount}</strong> references have an additional research topic; <strong>{pendingCount}</strong> have no research topic recorded. Major categories and quadrants are maintained separately.</p>{pendingCount > 0 && <a href={libraryLink({ category: 'Uncategorized' })}>Browse references without a research topic <Icon name="right" size={14}/></a>}</div>
      </section>
    </div>
    <footer class="map-note"><Icon name="book" size={19}/><p>Open a reference to see its categories, architecture, prediction paradigm, and review status. Combine category, subcategory, and quadrant filters in the index.</p><a href={`${pathFor()}#library`}>Explore all references <Icon name="right" size={15}/></a></footer>
  </div>
</BaseLayout>

<script>
  const modeLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-map-mode]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-map-panel]')];
  const allowed = new Set(modeLinks.map(link => link.dataset.mapMode));
  function showMode(mode: string, writeURL = false) {
    const selected = allowed.has(mode) ? mode : 'major';
    for (const panel of panels) panel.hidden = panel.dataset.mapPanel !== selected;
    for (const link of modeLinks) { const active = link.dataset.mapMode === selected; link.classList.toggle('selected', active); if (active) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current'); }
    if (writeURL) { const url = new URL(location.href); url.searchParams.set('mode', selected); history.pushState(null, '', url); }
  }
  for (const link of modeLinks) link.addEventListener('click', event => { if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); showMode(link.dataset.mapMode || 'major', true); });
  window.addEventListener('popstate', () => showMode(new URLSearchParams(location.search).get('mode') || 'major'));
  showMode(new URLSearchParams(location.search).get('mode') || 'major');
</script>

<style>
  .map-page { padding-block:55px 72px; min-width:0; }
  .map-header { display:flex; align-items:end; justify-content:space-between; gap:40px; padding-bottom:38px; }
  .map-header > div:first-child { max-width:680px; }
  h1 { margin:17px 0 18px; color:#25445f; font-size:calc(clamp(30px,3.2vw,43px) * var(--font-scale)); letter-spacing:-1.1px; font-weight:550; line-height:1.4; }
  h1 span { display:block; color:#718ba2; }
  .map-header p { max-width:600px; color:#74828f; font-size:calc(13px * var(--font-scale)); line-height:1.95; }
  .map-summary { display:flex; gap:27px; padding-bottom:5px; flex-shrink:0; }
  .map-summary div { display:flex; flex-direction:column; gap:6px; }
  .map-summary strong { color:#3d5a72; font-size:calc(29px * var(--font-scale)); font-weight:500; line-height:1.1; }
  .map-summary span { font-size:calc(10px * var(--font-scale)); color:#84919d; }
  .map-modes { display:flex; gap:8px; border-bottom:1px solid #dfe6ec; padding-bottom:14px; margin-bottom:32px; }
  .map-modes a { min-width:0; padding:12px 20px; border:1px solid transparent; border-radius:5px; display:flex; flex-direction:column; gap:3px; color:#7b8996; }
  .map-modes a span { font-size:calc(13px * var(--font-scale)); font-weight:550; }
  .map-modes a small { font-size:calc(9px * var(--font-scale)); }
  .map-modes a.selected { border-color:#cbd8e3; background:#eaf0f5; color:#345571; }
  .map-modes a:hover { background:#eef3f7; }
  .section-intro { display:flex; align-items:end; justify-content:space-between; gap:30px; margin-bottom:23px; }
  .section-intro .eyebrow { font-size:calc(8px * var(--font-scale)); margin-bottom:8px; }
  .section-intro h2 { color:#304e66; font-size:calc(22px * var(--font-scale)); font-weight:550; }
  .section-intro h3 { color:#476076; font-size:calc(15px * var(--font-scale)); font-weight:550; }
  .section-intro > p { color:#82909c; font-size:calc(11px * var(--font-scale)); line-height:1.8; max-width:420px; }
  .major-board { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:21px; align-items:start; }
  .board-column { border:1px solid #e0e7ed; border-top:3px solid var(--group-color); border-radius:6px; background:#f0f4f7; min-width:0; }
  .board-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:19px 18px 16px; }
  .board-heading h3 { font-size:calc(15px * var(--font-scale)); color:#34516a; font-weight:600; }
  .board-heading p { font-size:calc(10px * var(--font-scale)); color:#8a96a2; margin-top:4px; }
  .group-count { display:flex; flex-shrink:0; align-items:center; gap:8px; font-size:calc(21px * var(--font-scale)); font-weight:500; color:var(--group-color); }
  .board-subtypes { margin:0 18px 12px; color:#71818f; font-size:calc(10px * var(--font-scale)); }
  .board-subtypes summary { cursor:pointer; padding:4px 0; }
  .board-subtypes summary > span { margin-left:5px; color:#a0aab3; }
  .board-subtypes > div { display:flex; flex-wrap:wrap; gap:5px; max-height:146px; overflow:auto; padding-block:9px 3px; }
  .board-subtypes a { display:flex; max-width:100%; gap:7px; background:white; border:1px solid #dce5ed; padding:3px 6px; border-radius:3px; }
  .board-subtypes a span { color:#a0aab3; }
  .board-list { margin:0; list-style:none; padding:0 10px 2px; height:366px; overflow:auto; scrollbar-width:thin; scrollbar-color:#c9d5df transparent; overscroll-behavior:contain; }
  .board-list li { border:1px solid #e1e7ed; border-radius:4px; background:white; margin-bottom:8px; padding:14px 13px; }
  .board-paper-meta { display:flex; align-items:center; flex-wrap:wrap; gap:8px; color:#8b98a4; font-size:calc(9px * var(--font-scale)); margin-bottom:8px; }
  .mini-quadrant, .pending-badge { padding:1px 5px; border-radius:3px; background:#eff3f7; color:#6d879d; }
  .pending-badge { background:#f7efd9; color:#a38a4d; }
  .board-list h4 { color:#3b5266; font-size:calc(12px * var(--font-scale)); font-weight:550; line-height:1.65; margin:0; overflow-wrap:anywhere; }
  .board-list h4 a:hover { color:var(--group-color); text-decoration:underline; text-underline-offset:3px; }
  .board-list li > p { margin-top:8px; font-size:calc(9px * var(--font-scale)); color:#9ba5af; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
  .board-footer { display:flex; justify-content:space-between; padding:14px 18px; color:#6d8395; font-size:calc(10px * var(--font-scale)); }
  .board-empty { color:#93a0ac; font-size:calc(11px * var(--font-scale)); }
  .quadrant-key { display:flex; justify-content:space-between; align-items:center; gap:15px; font-size:calc(10px * var(--font-scale)); color:#8493a1; padding-bottom:18px; }
  .quadrant-key i { display:inline-block; width:5px; height:5px; margin-right:6px; border-radius:50%; background:#90a9bc; }
  .quadrant-matrix { display:grid; grid-template-columns:108px repeat(2,minmax(0,1fr)); gap:16px; }
  .axis-corner { display:flex; flex-direction:column; justify-content:end; gap:8px; padding-bottom:5px; font-size:calc(10px * var(--font-scale)); color:#95a2ad; }
  .column-axis { padding:0 20px 4px; display:flex; align-items:baseline; gap:10px; color:#4b647a; }
  .column-axis strong { font-weight:550; font-size:calc(14px * var(--font-scale)); }
  .column-axis span { color:#91a0ad; font-size:calc(10px * var(--font-scale)); }
  .row-axis { display:flex; justify-content:center; flex-direction:column; gap:6px; color:#506b81; }
  .row-axis strong { font-size:calc(12px * var(--font-scale)); font-weight:550; }
  .row-axis span { color:#9aa5ae; font-size:calc(10px * var(--font-scale)); }
  .quadrant-cell { display:flex; flex-direction:column; min-width:0; border:1px solid color-mix(in srgb,var(--group-color) 35%,white); border-radius:6px; background:color-mix(in srgb,var(--group-color) 4%,white); padding:24px; }
  .quadrant-cell header { display:flex; align-items:start; justify-content:space-between; gap:12px; padding-bottom:18px; border-bottom:1px solid color-mix(in srgb,var(--group-color) 15%,white); }
  .quadrant-code { color:var(--group-color); font-size:calc(10px * var(--font-scale)); font-weight:650; letter-spacing:.12em; }
  .quadrant-cell h3 { margin:5px 0 0; font-size:calc(13px * var(--font-scale)); font-weight:550; color:#405b72; }
  .quadrant-cell h3 span { display:block; font-weight:400; font-size:calc(11px * var(--font-scale)); margin-top:4px; color:#8192a0; }
  .quadrant-count { display:flex; align-items:end; flex-direction:column; color:var(--group-color); gap:3px; }
  .quadrant-count strong { font-size:calc(32px * var(--font-scale)); font-weight:450; line-height:1; }
  .quadrant-count > span { font-size:calc(9px * var(--font-scale)); }
  .quadrant-cell ol { padding:4px 0 0; margin:0; list-style:none; }
  .quadrant-cell li { padding:10px 0; font-size:calc(11px * var(--font-scale)); line-height:1.65; color:#6b7f90; border-bottom:1px solid #e7ecf0; }
  .quadrant-cell li a { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .quadrant-cell li a:hover { color:var(--group-color); text-decoration:underline; }
  .quadrant-footer { display:flex; justify-content:space-between; align-items:center; color:var(--group-color); font-size:calc(10px * var(--font-scale)); margin-top:auto; padding-top:20px; }
  .outside-section { margin:30px 0 0 124px; }
  .outside-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
  .outside-card { border:1px solid #e1e7ed; background:#f3f6f8; padding:18px 20px; border-radius:5px; }
  .outside-card > div { display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
  .outside-card h4 { margin:0; font-size:calc(12px * var(--font-scale)); color:#657c8f; font-weight:550; }
  .outside-card strong { font-size:calc(22px * var(--font-scale)); color:#718799; font-weight:450; }
  .outside-card p { font-size:calc(10px * var(--font-scale)); line-height:1.8; color:#8e9ba6; margin:7px 0 13px; }
  .outside-card > span { font-size:calc(9px * var(--font-scale)); color:#8396a5; }
  .outside-card.pending { border-color:#e5dcc4; background:#f8f5ec; }
  .outside-card.pending h4, .outside-card.pending strong { color:#9b8452; }
  .direction-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .direction-card { display:flex; flex-direction:column; padding:24px; border:1px solid #e0e7ed; border-radius:5px; background:white; }
  .direction-card > div { display:flex; justify-content:space-between; align-items:center; }
  .direction-card strong { color:var(--group-color); font-size:calc(22px * var(--font-scale)); font-weight:500; }
  .category-dot { width:7px; height:7px; border-radius:50%; background:var(--group-color); }
  .direction-card h3 { font-size:calc(16px * var(--font-scale)); line-height:1.45; color:#3c5870; margin:14px 0 10px; font-weight:550; }
  .direction-card p { color:#8b98a3; font-size:calc(11px * var(--font-scale)); line-height:1.8; margin-bottom:21px; }
  .direction-card > span { color:var(--group-color); font-size:calc(10px * var(--font-scale)); display:flex; justify-content:space-between; align-items:center; margin-top:auto; }
  .topic-coverage { border:1px dashed #d0dce5; padding:22px 25px; border-radius:5px; margin-top:22px; font-size:calc(11px * var(--font-scale)); line-height:1.8; color:#8194a2; }
  .topic-coverage a { display:inline-flex; align-items:center; gap:12px; color:#527590; margin-top:11px; }
  .map-help { color:#8796a2; font-size:calc(11px * var(--font-scale)); padding-block:14px; }
  .map-note { display:flex; align-items:center; gap:18px; border-top:1px solid #e0e7ed; padding-top:25px; margin-top:37px; color:#8193a2; }
  .map-note p { font-size:calc(11px * var(--font-scale)); line-height:1.9; max-width:690px; }
