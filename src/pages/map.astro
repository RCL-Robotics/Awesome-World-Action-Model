---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { categories, papers, classifiedCount, pendingCount, pathFor } from '../lib/catalog';
const total = papers.length;
---

<BaseLayout title="Research map" description="Explore the research directions connecting world modeling, action, learning, and evaluation." active="map">
  <div class="shell map-page">
    <header class="map-header">
      <span class="eyebrow">THE RESEARCH LANDSCAPE</span>
      <h1>Many directions.<br /><span>One world of possibilities.</span></h1>
      <p>Find your way through the ideas connecting world modeling and action. Explore a direction, then follow the papers that move it forward.</p>
      <div class="map-summary"><span><strong>{categories.length}</strong> research directions</span><span class="summary-divider" aria-hidden="true"></span><span><strong>{classifiedCount}</strong> classified papers</span>{pendingCount > 0 && <><span class="summary-divider" aria-hidden="true"></span><a href={`${pathFor()}?category=Uncategorized#library`}><strong>{pendingCount}</strong> awaiting classification</a></>}</div>
    </header>

    <section class="category-section" aria-labelledby="directions-heading">
      <div class="map-section-heading"><h2 id="directions-heading">Explore by research direction</h2><span>Primary categories · percentages of all {total} papers</span></div>
      <div class="direction-grid">
        {categories.map((category, index) => <a class="direction-card" href={`${pathFor()}?category=${encodeURIComponent(category.name)}#library`} style={`--direction-color:${category.color}`}>
          <div class="direction-top"><span class="direction-number">{String(index + 1).padStart(2, '0')}</span><Icon name="arrow" size={19} /></div>
          <h3>{category.label}</h3>
          <p>{category.description}</p>
          <div class="direction-bottom"><div class="direction-stat"><strong>{category.count}</strong><span>{category.count === 1 ? 'paper' : 'papers'}</span><span class="direction-percent">{total ? Math.round(category.count / total * 100) : 0}% of collection</span></div><div class="direction-track" aria-hidden="true"><span style={`width:${total ? category.count / total * 100 : 0}%`}></span></div></div>
        </a>)}
      </div>
    </section>

    {pendingCount > 0 && <section class="pending-map" aria-labelledby="pending-heading"><div><span class="eyebrow">COLLECTION IN PROGRESS</span><h2 id="pending-heading">{pendingCount} papers still to be mapped</h2><p>These records are available in the library while their research directions await classification.</p></div><a class="button button-secondary" href={`${pathFor()}?category=Uncategorized#library`}>Browse unclassified papers <Icon name="right" size={16}/></a></section>}
    <section class="map-note" aria-label="How to use the research map">
      <div class="map-note-icon"><Icon name="book" size={21}/></div>
      <div><h2>Follow the connections</h2><p>Classified papers have one primary category and may include secondary categories. Use the library filters to discover the overlaps between research directions.</p></div>
      <a class="button button-secondary" href={`${pathFor()}#library`}>Explore all papers <Icon name="right" size={16}/></a>
    </section>
  </div>
</BaseLayout>

<style>
  .map-page { padding-top:65px; padding-bottom:83px; }
  .map-header { max-width:690px; padding-bottom:55px; }
  h1 { color:#1f3c55; font-size:clamp(33px,4.2vw,49px); line-height:1.16; letter-spacing:-1.7px; font-weight:600; margin:19px 0 20px; }
  h1 span { color:#718ba2; }
  .map-header > p { font-size:14px; line-height:1.9; color:#72808e; max-width:540px; margin:0; }
  .map-summary { display:flex; flex-wrap:wrap; align-items:center; gap:14px; margin-top:25px; font-size:11px; color:#84919d; }
  .map-summary a { color:#728699; }
  .map-summary strong { font-size:16px; font-weight:600; color:#3d5a72; margin-right:5px; }
  .summary-divider { width:1px; height:17px; background:#dce4ea; }
  .category-section { border-top:1px solid #e2e8ed; padding-top:26px; }
  .map-section-heading { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:23px; }
  .map-section-heading h2 { color:#385168; font-size:15px; font-weight:600; letter-spacing:-.15px; margin:0; }
  .map-section-heading > span { font-size:10px; color:#929da8; }
  .direction-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .direction-card { display:flex; flex-direction:column; text-decoration:none; border:1px solid #e0e7ed; border-radius:5px; padding:25px 25px 23px; background:#fff; transition:border-color .2s,transform .2s,box-shadow .2s; }
  .direction-card:hover { border-color:var(--direction-color); transform:translateY(-3px); box-shadow:0 6px 20px #233d5410; }
  .direction-top { display:flex; justify-content:space-between; align-items:center; color:var(--direction-color); margin-bottom:21px; }
  .direction-number { display:flex; width:33px; height:33px; align-items:center; justify-content:center; border:1px solid color-mix(in srgb,var(--direction-color) 25%, white); background:color-mix(in srgb,var(--direction-color) 6%, white); border-radius:6px; font-size:11px; font-weight:500; font-variant-numeric:tabular-nums; }
  .direction-card h3 { color:#2c485f; font-size:18px; font-weight:600; letter-spacing:-.4px; line-height:1.35; margin:0 0 11px; }
  .direction-card > p { color:#7d8995; font-size:12px; line-height:1.9; margin:0 0 27px; }
  .direction-bottom { margin-top:auto; }
  .direction-stat { display:flex; align-items:baseline; gap:5px; margin-bottom:12px; color:#929ca7; font-size:10px; }
  .direction-stat strong { font-size:21px; color:#476076; font-weight:500; letter-spacing:-.5px; }
  .direction-percent { margin-left:auto; font-size:9px; }
  .direction-track { background:#f0f3f5; width:100%; height:3px; border-radius:3px; overflow:hidden; }
  .direction-track span { display:block; height:100%; min-width:0; background:var(--direction-color); border-radius:3px; }
  .pending-map { display:flex; gap:25px; justify-content:space-between; align-items:center; margin-top:23px; padding:26px; border:1px dashed #cbd7e0; border-radius:5px; background:#f4f7f9; }
  .pending-map h2 { color:#4b6479; font-size:18px; font-weight:500; margin:10px 0 7px; }
  .pending-map p { color:#80909e; font-size:11px; line-height:1.8; margin:0; }
  .pending-map .button { flex-shrink:0; }
  .map-note { margin-top:35px; display:flex; gap:19px; align-items:center; padding:25px 27px; border:1px solid #e1e8ee; border-radius:5px; background:#f4f7fa; }
  .map-note-icon { color:#6988a3; padding-top:2px; }
  .map-note h2 { font-size:13px; color:#4a6379; font-weight:600; margin:0 0 6px; }
  .map-note p { color:#80909e; font-size:11px; line-height:1.8; max-width:575px; margin:0; }
  .map-note .button { flex-shrink:0; margin-left:auto; }
  @media (max-width:900px) { .direction-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }.map-note { flex-wrap:wrap; }.map-note .button { margin-left:40px; } }
  @media (max-width:580px) { .map-page { padding-top:40px; padding-bottom:55px; }.map-header { padding-bottom:35px; }h1 { letter-spacing:-1px; }.direction-grid { grid-template-columns:1fr; }.map-section-heading { align-items:start; flex-direction:column; gap:7px; }.direction-card { padding:23px; }.direction-top { margin-bottom:15px; }.direction-card > p { margin-bottom:20px; }.map-note { padding:22px; gap:14px; }.map-note-icon { display:none; }.map-note .button { margin-left:0; } }
  @media (max-width:580px) { .pending-map { padding:22px; flex-direction:column; align-items:start; gap:17px; } }
  @media (prefers-reduced-motion:reduce) { .direction-card { transition:none; }.direction-card:hover { transform:none; } }
</style>
