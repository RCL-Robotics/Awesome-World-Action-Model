---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { pathFor } from '../lib/catalog';
---

<BaseLayout title="Page not found" active="">
  <div class="shell not-found"><span class="error-code">404</span><span class="eyebrow">AN UNEXPLORED DIRECTION</span><h1>This page could not be found.</h1><p>The link may have changed. Return to the library to find papers and explore the collection.</p><a class="button button-primary" href={pathFor()}>Back to the library <Icon name="right" size={17}/></a></div>
</BaseLayout>

<style>
  .not-found { display:flex; flex-direction:column; align-items:center; text-align:center; padding-top:90px; padding-bottom:110px; }
  .error-code { color:#d8e3ec; font-size:90px; font-weight:500; letter-spacing:-5px; line-height:1; margin-bottom:27px; }
  .not-found .eyebrow { font-size:10px; }
  h1 { color:#2d4961; font-size:clamp(25px,4vw,34px); font-weight:600; letter-spacing:-.9px; margin:17px 0 13px; }
  p { color:#83919e; font-size:13px; line-height:1.9; max-width:400px; margin:0 0 26px; }
  @media (max-width:600px) { .not-found { padding-top:65px; padding-bottom:80px; }.error-code { font-size:75px; } }
</style>
