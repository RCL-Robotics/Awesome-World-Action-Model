---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PaperDate from '../../components/PaperDate.astro';
import ReportCta from '../../components/reports/ReportCta.astro';
import { papers, categoryFor, majorCategoryFor, quadrantFor, formatDate, venueLabel, paperSourceUrl, paperPath, pathFor, repoUrl, type Paper } from '../../lib/catalog';
import { taxonomyLabel } from '../../lib/taxonomy.mjs';

export function getStaticPaths() {
  return papers.map(paper => ({ params: { id: paper.id }, props: { paper } }));
}

interface Props { paper: Paper; }
const { paper } = Astro.props;
const category = categoryFor(paper.primaryCategory);
const majorCategory = majorCategoryFor(paper.majorCategory);
const quadrant = quadrantFor(paper.quadrant);
const classificationHref = (key: 'major' | 'quadrant' | 'subtype', value: string | null) => `${pathFor()}?${key}=${encodeURIComponent(value || '__unassigned__')}#library`;
const categoryHref = (name: string) => `${pathFor()}?category=${encodeURIComponent(name)}#library`;
const secondaryHref = (name: string) => `${pathFor()}?secondary=${encodeURIComponent(name)}#library`;
const related = paper.majorCategory ? papers.filter(item => item.id !== paper.id && item.majorCategory === paper.majorCategory).slice(0, 3) : [];
const sourceUrl = paperSourceUrl(paper);
const correctionUrl = `${repoUrl}/issues/new?title=${encodeURIComponent(`Paper correction: ${paper.title}`)}&body=${encodeURIComponent(`Paper: ${paper.title}\nSource: ${sourceUrl}\n\nSuggested correction:\n`)}`;
---

<BaseLayout title={paper.title} description={paper.contribution || paper.abstract || `Research paper: ${paper.title}. Explore the source and available publication details.`}>
  <article class="shell paper-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={pathFor()}>Library</a><span aria-hidden="true">/</span>
      <a href={classificationHref('major', paper.majorCategory)}>{majorCategory?.label || 'Not assigned'}</a>
      <span aria-hidden="true">/</span><span aria-current="page">Paper</span>
    </nav>

    <header class="paper-header">
      <div class="paper-kicker"><span class="eyebrow">RESEARCH PAPER</span><span class="kicker-dot" aria-hidden="true"></span><PaperDate paper={paper} prefix/></div>
      <h1>{paper.title}</h1>
      {paper.authors.length > 360 ? (
        <details class="authors-disclosure"><summary>View all authors</summary><p class="authors">{paper.authors}</p></details>
      ) : <p class="authors">{paper.authors || 'Authors not listed'}</p>}
      <div class="paper-actions">
        <a class="button button-primary" href={paper.arxivUrl || sourceUrl} target="_blank" rel="noopener noreferrer">{paper.arxivUrl ? 'Read on arXiv' : 'Read paper'} <Icon name="arrow" size={16} /></a>
        {paper.pdfUrl && <a class="button button-secondary" href={paper.pdfUrl} target="_blank" rel="noopener noreferrer">PDF <Icon name="arrow" size={15}/></a>}
        {paper.doi && <a class="button button-secondary" href={paper.doi} target="_blank" rel="noopener noreferrer">DOI <Icon name="arrow" size={15}/></a>}
        {paper.codeUrls.map((url, index) => <a class="button button-secondary" href={url} target="_blank" rel="noopener noreferrer"><Icon name="code" size={17} /> {paper.codeUrls.length > 1 ? `Code ${index + 1}` : 'Code'}</a>)}
        {paper.projectUrl && <a class="button button-secondary" href={paper.projectUrl} target="_blank" rel="noopener noreferrer">Project page <Icon name="arrow" size={15} /></a>}
      </div>
    </header>

    <ReportCta paperId={paper.id}/>

    <div class="paper-grid">
      <div class="paper-body">
        <section class="classification-panel" aria-labelledby="classification-heading">
          <div class="classification-heading"><h2 id="classification-heading">Classification</h2><a href={pathFor('map/?mode=quadrants')}>View four quadrants <Icon name="arrow" size={14}/></a></div>
          <dl class="classification-grid">
            <div><dt>Major category</dt><dd><a class="category-link" href={classificationHref('major', paper.majorCategory)} style={`--category-color:${majorCategory?.color || '#8b96a1'}`}><span class="category-dot" aria-hidden="true"></span>{taxonomyLabel(paper.majorCategory)}<Icon name="arrow" size={13}/></a></dd></div>
            <div><dt>Quadrant</dt><dd><a class="category-link" href={classificationHref('quadrant', paper.quadrant)} style={`--category-color:${quadrant?.color || '#8b96a1'}`}><span class="category-dot" aria-hidden="true"></span>{taxonomyLabel(paper.quadrant)}<Icon name="arrow" size={13}/></a></dd></div>
            <div><dt>Architecture</dt><dd>{taxonomyLabel(paper.architecture)}</dd></div>
            <div><dt>Prediction paradigm</dt><dd>{taxonomyLabel(paper.predictionParadigm)}</dd></div>
            <div class="classification-subtypes"><dt>Subcategories</dt><dd class="secondary-categories">{paper.subcategories?.length ? paper.subcategories.map(name => <a class="tag" href={classificationHref('subtype', name)}>{taxonomyLabel(name)}</a>) : <span class="muted">Not recorded</span>}</dd></div>
            <div class="classification-status"><dt>Review status</dt><dd>{taxonomyLabel(paper.classificationStatus)}</dd></div>
          </dl>
        </section>
        <section class="contribution-panel" aria-labelledby="contribution-heading">
          <span class="eyebrow">AT A GLANCE</span>
          <h2 id="contribution-heading">Contribution</h2>
          <p>{paper.contribution || 'A contribution summary has not been added yet.'}</p>
        </section>

        <section class="text-section" aria-labelledby="abstract-heading">
          <h2 id="abstract-heading">Abstract</h2>
          <p class="abstract">{paper.abstract || 'An abstract has not been added yet.'}</p>
        </section>

        <section class="text-section affiliations-section" aria-labelledby="affiliations-heading">
          <h2 id="affiliations-heading">Affiliations</h2>
          <p>{paper.affiliations || 'Not listed in the collection.'}</p>
        </section>
        {paper.bibtex && <section class="text-section bibtex-section" aria-labelledby="bibtex-heading" data-copy-region>
          <h2 id="bibtex-heading">BibTeX</h2>
          <label class="sr-only" for="paper-bibtex">Recorded BibTeX citation</label>
          <textarea id="paper-bibtex" readonly rows={Math.min(Math.max(paper.bibtex.split('\n').length, 5), 14)} spellcheck="false">{paper.bibtex}</textarea>
          <button class="copy-button bibtex-copy" type="button" data-copy-target="paper-bibtex" data-copy-label="BibTeX"><Icon name="copy" size={15}/><span>Copy BibTeX</span></button>
          <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        </section>}
      </div>

      <aside class="paper-sidebar" aria-label="Paper information">
        <section class="metadata-card">
          <h2>Paper details</h2>
          <dl>
            <div><dt>Submission date</dt><dd>{paper.submittedDate ? <time datetime={paper.submittedDate}>{formatDate(paper.submittedDate)}</time> : <span class="muted">Date not recorded</span>}</dd></div>
            {paper.publicationYear && <div><dt>Publication year</dt><dd>{paper.publicationYear}</dd></div>}
            <div><dt>Research topic</dt><dd><a class="category-link" href={categoryHref(paper.primaryCategory)} style={`--category-color:${category?.color || '#82929f'}`}><span class="category-dot" aria-hidden="true"></span>{category?.label || paper.primaryCategory}<Icon name="arrow" size={13}/></a></dd></div>
            <div><dt>Related research topics</dt><dd class="secondary-categories">{paper.secondaryCategories.length ? paper.secondaryCategories.map(name => <a class="tag" href={secondaryHref(name)}>{name}</a>) : <span class="muted">None listed</span>}</dd></div>
            {paper.venue && <div><dt>Venue</dt><dd>{venueLabel(paper.venue)}</dd></div>}
            <div><dt>BibTeX key</dt><dd class="bibtex-key"><code>{paper.bibtexKey || 'Not listed'}</code></dd></div>
          </dl>
          <div class="source-reference" data-copy-region>
            <label for="paper-source-url">Paper reference link</label>
            <input id="paper-source-url" value={sourceUrl} readonly aria-label="Paper reference link" />
            <button class="copy-button" type="button" data-copy-target="paper-source-url" data-copy-label="Reference link"><Icon name="copy" size={15} /><span>Copy reference link</span></button>
            <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
          </div>
        </section>
        <a class="correction-link" href={correctionUrl} target="_blank" rel="noopener noreferrer">Suggest a correction <Icon name="arrow" size={14} /></a>
      </aside>
    </div>

    {related.length > 0 && <section class="related-section" aria-labelledby="related-heading">
      <div class="related-heading"><div><span class="eyebrow">KEEP EXPLORING</span><h2 id="related-heading">More in this category</h2></div><a href={classificationHref('major', paper.majorCategory)}>View category <Icon name="right" size={17}/></a></div>
      <div class="related-grid">{related.map(item => <a class="related-card" href={paperPath(item.id)}><PaperDate paper={item}/><h3>{item.title}</h3><div class="related-card-footer"><span>{majorCategory?.label || taxonomyLabel(item.majorCategory)}</span><Icon name="arrow" size={17}/></div></a>)}</div>
    </section>}
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach(button => {
    button.addEventListener('click', async () => {
      const input = document.getElementById(button.dataset.copyTarget || '');
      const status = button.closest('[data-copy-region]')?.querySelector<HTMLElement>('[data-copy-status]');
      if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) || !status) return;
      try {
        await navigator.clipboard.writeText(input.value);
        status.textContent = `${button.dataset.copyLabel || 'Text'} copied.`;
      } catch {
        input.focus();
        input.select();
        status.textContent = 'Text selected. Press Ctrl+C or ⌘C to copy.';
      }
    });
  });
</script>

<style>
  .paper-page { padding-top: 34px; padding-bottom: 84px; }
  .breadcrumbs { display:flex; flex-wrap:wrap; align-items:center; gap:11px; color:#8a939f; font-size:12px; margin-bottom:40px; }
  .breadcrumbs a { color:#697583; text-decoration:none; }
  .breadcrumbs a:hover { color:#244c75; }
  .paper-header { max-width:1000px; padding-bottom:39px; }
  .paper-kicker { display:flex; align-items:center; gap:12px; color:#778391; font-size:12px; margin-bottom:19px; }
  .kicker-dot { width:3px; height:3px; background:#a0aab4; border-radius:50%; }
  h1 { margin:0 0 21px; color:#18344e; font-size:clamp(28px,3.05vw,43px); letter-spacing:-1.3px; line-height:1.22; font-weight:600; text-wrap:balance; }
  .authors { color:#687583; font-size:14px; line-height:1.85; margin:0; white-space:pre-wrap; overflow-wrap:anywhere; }
  .authors-disclosure { color:#53677c; font-size:14px; }
  .authors-disclosure summary { cursor:pointer; width:fit-content; }
  .authors-disclosure .authors { margin-top:12px; }
  .paper-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:25px; }
  .paper-grid { display:grid; grid-template-columns:minmax(0,1fr) 296px; gap:52px; border-top:1px solid #e7ebee; padding-top:35px; }
  .paper-body { min-width:0; }
  .classification-panel { padding:23px 25px; border:1px solid #dce5ed; border-radius:5px; margin-bottom:24px; background:white; }
  .classification-heading { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:23px; }
  .classification-heading h2 { margin:0; font-size:18px; }
  .classification-heading a { display:inline-flex; align-items:center; gap:5px; font-size:10px; color:#7a91a5; }
  .classification-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
  .classification-grid > div { margin:0; min-width:0; }
  .classification-subtypes, .classification-status { grid-column:1/-1; }
  .classification-grid dt { letter-spacing:.6px; font-size:9px; }
  .classification-grid dd { font-size:12px; overflow-wrap:anywhere; }
  h2 { color:#233d54; font-size:20px; font-weight:600; letter-spacing:-.35px; margin:0 0 15px; }
  .contribution-panel { border:1px solid #dce6ee; border-left:3px solid #7297b8; background:#f5f8fb; border-radius:4px; padding:24px 26px; }
  .contribution-panel .eyebrow { font-size:10px; }
  .contribution-panel h2 { margin-top:9px; font-size:18px; }
  .contribution-panel p { color:#536779; line-height:1.85; font-size:14px; margin:0; white-space:pre-wrap; }
  .text-section { padding-top:34px; }
  .text-section p { font-size:14px; line-height:1.95; color:#5b6978; margin:0; white-space:pre-wrap; overflow-wrap:anywhere; }
  .affiliations-section { border-top:1px solid #e7ebee; margin-top:34px; }
  .affiliations-section h2 { font-size:16px; }
  .affiliations-section p { color:#71808e; font-size:13px; }
  .bibtex-section textarea { display:block; resize:vertical; width:100%; max-width:100%; min-height:120px; padding:17px; border:1px solid #dce5ed; border-radius:4px; background:#f3f7fa; color:#607587; font:11px/1.8 ui-monospace,monospace; white-space:pre-wrap; overflow-wrap:anywhere; }
  .bibtex-copy { width:auto !important; padding-inline:14px !important; }
  .metadata-card { border:1px solid #e2e8ed; border-radius:6px; background:white; padding:24px 22px 12px; }
  .metadata-card h2 { font-size:15px; margin-bottom:22px; }
  dl { margin:0; }
  dl > div { margin-bottom:24px; }
  dt, .source-reference label { font-size:10px; letter-spacing:1px; text-transform:uppercase; color:#84909c; font-weight:600; margin-bottom:8px; }
  dd { margin:0; font-size:12px; color:#40566a; line-height:1.65; }
  .category-link { display:inline-flex; align-items:center; gap:7px; text-decoration:none; color:#486780; }
  .category-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; background:var(--category-color); }
  .secondary-categories { display:flex; flex-wrap:wrap; gap:6px; }
  .secondary-categories a { text-decoration:none; font-size:10px; padding:4px 7px; line-height:1.4; }
  .muted { color:#8b959f; }
  .bibtex-key { overflow-wrap:anywhere; }
  .bibtex-key code { font-size:11px; }
  .source-reference { border-top:1px solid #e9edf0; padding-top:21px; }
  .source-reference label { display:block; }
  .source-reference input { box-sizing:border-box; width:100%; border:1px solid #e2e8ed; background:#f8fafb; color:#66788a; padding:9px; font-size:11px; border-radius:3px; }
  .copy-button { cursor:pointer; display:flex; align-items:center; justify-content:center; gap:7px; width:100%; border:1px solid #dce4eb; border-radius:4px; background:white; color:#4a6580; font:inherit; font-size:11px; padding:9px; margin-top:9px; }
  .copy-button:hover { background:#f3f7fa; }
  .copy-status { min-height:28px; color:#627d6e; font-size:10px; margin:7px 0 0; line-height:1.5; }
  .correction-link { display:flex; justify-content:center; align-items:center; gap:6px; margin-top:17px; text-decoration:none; color:#7d8a96; font-size:11px; }
  .related-section { margin-top:65px; border-top:1px solid #e3e9ee; padding-top:35px; }
  .related-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:23px; }
  .related-heading h2 { margin:9px 0 0; font-size:23px; }
  .related-heading > a { display:flex; gap:7px; align-items:center; text-decoration:none; color:#5a748d; font-size:12px; white-space:nowrap; }
  .related-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:17px; }
  .related-card { display:flex; flex-direction:column; border:1px solid #e0e7ed; border-radius:5px; text-decoration:none; padding:23px; background:white; transition:border-color .2s,transform .2s; }
  .related-card:hover { border-color:#90aec7; transform:translateY(-2px); }
  .related-card time, .related-card :global(.paper-date) { color:#8994a0; font-size:10px; }
  .related-card h3 { color:#28455e; font-size:14px; font-weight:600; line-height:1.6; margin:13px 0 24px; }
  .related-card-footer { display:flex; gap:10px; justify-content:space-between; align-items:center; margin-top:auto; color:#83919f; font-size:10px; }
  @media (max-width:900px) { .paper-grid { grid-template-columns:minmax(0,1fr) 250px; gap:26px; }.related-card { padding:18px; } }
  @media (max-width:680px) { .paper-page { padding-top:24px; padding-bottom:55px; }.breadcrumbs { margin-bottom:28px; }.paper-grid { grid-template-columns:1fr; gap:30px; }.paper-header { padding-bottom:28px; }h1 { letter-spacing:-.7px; }.paper-kicker { flex-wrap:wrap; gap:9px; }.contribution-panel { padding:21px; }.related-grid { grid-template-columns:1fr; }.related-heading { align-items:start; }.related-heading > a { margin-top:28px; }.related-heading h2 { font-size:20px; }.related-section { margin-top:42px; }.metadata-card { padding:24px; }.copy-status { min-height:15px; } }
  @media (prefers-reduced-motion:reduce) { .related-card { transition:none; }.related-card:hover { transform:none; } }
  @media (max-width:520px) { .classification-panel { padding:20px; }.classification-grid { grid-template-columns:1fr; gap:17px; }.classification-heading { align-items:start; gap:12px; }.classification-heading a { max-width:115px; text-align:right; } }
</style>
