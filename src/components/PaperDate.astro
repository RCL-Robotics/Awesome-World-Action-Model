---
import { formatDate, type Paper } from '../lib/catalog';
interface Props { paper: Pick<Paper, 'submittedDate' | 'publicationYear'>; prefix?: boolean; }
const { paper, prefix = false } = Astro.props;
---
{paper.submittedDate ? <time datetime={paper.submittedDate}>{prefix ? 'Submitted ' : ''}{formatDate(paper.submittedDate)}</time> : <span class="paper-date">{paper.publicationYear ? `Year ${paper.publicationYear}` : 'Date not recorded'}</span>}
