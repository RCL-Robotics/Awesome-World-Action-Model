---
import { pathFor } from '../../lib/catalog';
import type { ReportVisual } from '../../lib/illustrated-reports';
import EvidenceRefs from './EvidenceRefs.astro';
interface Props { visual: ReportVisual; eager?: boolean; }
const { visual, eager = false } = Astro.props;
const htmlLocation = visual.htmlSource?.anchor ? `#${visual.htmlSource.anchor}` : 'original section';
const mediaLabel = visual.htmlSource?.kind==='html-gif-derived-still' ? 'GIF-derived still · frame 0 (0 ms)' : visual.htmlSource?.kind==='html-original-table' ? 'Original HTML table' : visual.htmlSource?.kind === 'html-animation-derived-still' ? 'Animation-derived still' : visual.htmlSource?.kind === 'html-original-raster' ? 'Original raster' : 'Original HTML';
const mp4 = visual.mp4Source;
const sampledLocation = mp4 ? `Original MP4 sampled still · ${mp4.clipId} · requested ${mp4.requestedSeconds.toFixed(3)} s, decoded ${mp4.actualSeconds.toFixed(3)} s` : '';
const sourceLocation = mp4 ? sampledLocation : visual.htmlSource ? `${mediaLabel} · ${htmlLocation}` : `PDF page ${visual.page}`;
const sourceLinkLabel = mp4 ? 'Original Microsoft source' : visual.htmlSource ? `Original source, ${htmlLocation}` : `Original paper, p. ${visual.page}`;
---
<figure class="ir-visual" id={`visual-${visual.id}`}>
  <button class="ir-image-button" type="button" data-enlarge-image aria-label={`Enlarge ${visual.sourceLabel}: ${visual.caption}`} data-image-caption={`${visual.sourceLabel} · ${sourceLocation} — ${visual.caption}`}>
    <img src={pathFor(visual.asset)} width={visual.width} height={visual.height} alt={visual.alt} loading={eager ? 'eager' : 'lazy'} decoding="async"/>
    <span class="ir-enlarge-hint" aria-hidden="true">↗ Enlarge figure</span>
  </button>
  <figcaption><p><strong>{visual.sourceLabel}.</strong> {visual.caption} <a href={visual.sourceUrl}>{sourceLinkLabel} ↗</a>{mp4 && <> · <a href={mp4.originalMp4Url}>Original MP4 ↗</a></>}{visual.htmlSource?.kind==='html-gif-derived-still' && <> · <a href={visual.htmlSource.originalAssetUrl}>Original GIF ↗</a></>}</p><p class="ir-source-note">{visual.htmlSource || mp4 ? visual.sourceRendering : "Excerpt from the authors’ paper; cropped without altering the figure or table."}</p></figcaption>
  <div class="ir-visual-reading"><p><strong>How to read it.</strong> {visual.readingGuide} <EvidenceRefs ids={visual.evidenceIds}/></p><p><strong>What it supports.</strong> {visual.takeaway}</p><p><strong>Where the evidence stops.</strong> {visual.caution}</p></div>
</figure>
