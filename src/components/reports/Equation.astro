---
import katex from 'katex';
import 'katex/dist/katex.min.css';
import EvidenceRefs from './EvidenceRefs.astro';
interface Props { expression: string; explanation: string; evidenceIds: string[]; }
const { expression, explanation, evidenceIds } = Astro.props;
let rendered = '';
try {
  const result = katex.renderToString(expression, { displayMode: true, output: 'htmlAndMathml', trust: false, throwOnError: false, strict: 'warn', maxExpand: 1000 });
  if (!result.includes('class="katex-error"')) rendered = result;
} catch { /* Preserve the original expression when it cannot be rendered. */ }
---
<figure class="rn-equation">
  {rendered ? <div class="rn-math" set:html={rendered}/> : <pre class="rn-equation-fallback"><code>{expression}</code></pre>}
  <figcaption>{explanation} <EvidenceRefs ids={evidenceIds}/></figcaption>
</figure>
