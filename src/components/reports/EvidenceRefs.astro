---
import { reportAnchor } from '../../lib/reports';
interface Props { ids: string[]; }
const { ids } = Astro.props;
---
{ids.length > 0 && <span class="rn-evidence-refs" aria-label="Supporting evidence">{ids.map(id => <a href={`#${reportAnchor('evidence', id)}`} data-evidence-link aria-label={`View evidence ${id}`}>{id}</a>)}</span>}
