---
import Claim from './Claim.astro';
import EvidenceRefs from './EvidenceRefs.astro';
import Equation from './Equation.astro';
import SourceVisual from './SourceVisual.astro';
import ReportContents from './ReportContents.astro';
import paperMetadata from '../../../data/illustrated-report-metadata.json';
import { paperPath, pathFor, type Paper, meta, venueLabel } from '../../lib/catalog';
import { classificationSnapshot } from '../../lib/classification-snapshot.mjs';
import { type ReadingReport, reportAnchor, assessmentLabel, appendixLabel } from '../../lib/reports';
import { type IllustratedReport as IllustratedEdition, illustratedReports, illustratedSections } from '../../lib/illustrated-reports';
interface Props { paper: Paper; report: ReadingReport; edition: IllustratedEdition; }
const { paper, report, edition } = Astro.props;
const titleBlock = (paperMetadata as Record<string, { authors: string; affiliations?: string; sourceSha256: string; page?: number; location?: string }>)[paper.id];
if (!titleBlock || titleBlock.sourceSha256 !== report.sources[0].sha256) throw new Error(`Unverified title-block metadata for ${paper.id}`);
const seriesIndex = illustratedReports.findIndex(item => item.paperId === paper.id);
const methodVisuals = edition.visuals.filter(item => item.section === 'mechanism');
const resultVisuals = edition.visuals.filter(item => item.section === 'results');
const ablationVisuals = edition.visuals.filter(item => item.section === 'ablation');
const snapshot = report.taxonomy.recordedClassification;
const changed = classificationSnapshot(paper, meta.updatedAt).fingerprint !== snapshot.fingerprint;
const plainSynopsis = report.synopsis.replace(/\s*\[[a-zA-Z0-9_, -]+\]/g, '');
const readingMinutes = report.readingTimeMinutes + Math.ceil(JSON.stringify(edition).split(/\s+/).length / 220);
const featuredTasks: Record<string, string> = {
  '2609.02531': 'LIBERO-Plus robustness',
  '2609.02159': 'RoboTwin 2.0 Horizon-3 manipulation',
  '2608.24882': 'RoboCasa full-data manipulation',
  '2609.00188': 'Deployment acceleration',
  '2608.30237': 'Five-task main manipulation suite',
  '2608.22067': 'Overall physical task completion',
  '2608.29937': 'Closed-loop LIBERO manipulation',
  '2608.10860': 'Effect of inference-time future generation',
  '2608.28995': 'Short-range physical planning',
  '2608.08839': 'Robustness to perturbations',
};
const featuredTask = edition.featuredResultTask ?? featuredTasks[paper.id];
const featured = featuredTask ? report.results.find(result => result.task === featuredTask) : report.results[0];
const coreContribution = report.contributions[0];
---
<article class="rn-report ir-report">
  <header class="ir-header">
    <div class="ir-document-tools"><span class="ir-report-badge">PAPER REPORT</span><span class="ir-language" aria-label="Report language">EN</span><a href={`${pathFor('reports/')}#illustrated`}>All readings ↗</a></div>
    <h1>{paper.title}</h1>
    <div class="ir-meta">
      <p><strong>English reading report:</strong> Method, equations, original figures, experiments and reproducibility.</p>
      <p><strong>Authors:</strong> {titleBlock.authors}</p>
      {titleBlock.affiliations && <p><strong>Affiliations:</strong> {titleBlock.affiliations}</p>}
      <p><strong>Source:</strong> {paper.venue ? `${venueLabel(paper.venue)} · ` : ''}<a href={report.sources[0].url}>{paper.id} ↗</a>{paper.projectUrl && <> · <a href={paper.projectUrl}>Project page ↗</a></>} · <a href={paperPath(paper.id)}>Catalog record</a></p>
      <p><strong>Reading:</strong> {seriesIndex + 1} / {illustratedReports.length} · {edition.visuals.length} original {edition.visuals.length === 1 ? 'visual' : 'figures & tables'} · ~{readingMinutes} min · <button id="print-report" type="button">Print / save PDF</button></p>
    </div>
  </header>
  <ReportContents sections={illustratedSections}/>
  <div class="ir-body" data-report-body>
    <section id="overview" class="ir-section" data-report-section>
      <h2>1. Paper overview</h2>
      <p class="ir-tldr"><strong>In one sentence:</strong> {edition.thesis} <EvidenceRefs ids={edition.evidenceIds}/></p>
      <div class="ir-table-scroll" role="region" aria-label="Paper overview" tabindex="0"><table class="ir-overview-table">
        <thead><tr><th scope="col">At a glance</th><th scope="col">What to know</th></tr></thead>
        <tbody>
          <tr><th scope="row">Research problem</th><td><Claim claim={report.problem}/></td></tr>
          {coreContribution && <tr><th scope="row">Core mechanism</th><td><Claim claim={coreContribution}/></td></tr>}
          {featured && <tr><th scope="row">A key reported result</th><td><strong>{featured.task}: {featured.value}</strong><p>{featured.metric}. {featured.setting}</p><p>{featured.comparison} {featured.interpretation} <EvidenceRefs ids={featured.evidenceIds}/></p></td></tr>}
          {report.limitations[0] && <tr><th scope="row">Reading caution</th><td><Claim claim={report.limitations[0]}/></td></tr>}
        </tbody>
      </table></div>
      <h3>Core contributions</h3>
      <ul class="ir-contributions">{report.contributions.map(claim => <li><Claim claim={claim}/></li>)}</ul>
      {methodVisuals[0] && <SourceVisual visual={methodVisuals[0]} eager/>}
    </section>

    <section id="motivation" class="ir-section" data-report-section>
      <h2>2. Motivation</h2>
      <h3>2.1 The problem and the proposed response</h3><Claim claim={report.problem}/>
      <h3>2.2 What this reading follows</h3><p>{edition.standfirst} <EvidenceRefs ids={edition.evidenceIds}/></p>
    </section>

    <section id="taxonomy" class="ir-section" data-report-section>
      <h2>3. Research context</h2>
      <p>We place the paper in the collection through its world–action interface. The catalog labels and the reading’s assessment are shown separately.</p>
      <div class="ir-table-scroll" role="region" aria-label="Recorded WAM classification" tabindex="0"><table><thead><tr><th scope="col">Catalog dimension</th><th scope="col">Recorded classification</th></tr></thead><tbody>
        <tr><th scope="row">Major category</th><td>{snapshot.majorCategory}</td></tr>
        <tr><th scope="row">Architecture</th><td>{snapshot.architecture}</td></tr>
        <tr><th scope="row">Prediction paradigm</th><td>{snapshot.predictionParadigm}</td></tr>
        <tr><th scope="row">Quadrant</th><td>{snapshot.quadrant}</td></tr>
      </tbody></table></div>
      {changed && <p class="ir-note">The catalog has changed since this reading. <a href={paperPath(paper.id)}>Check the current record.</a></p>}
      <h3>3.1 Evidence-based assessment</h3><p><strong>{assessmentLabel[report.taxonomy.assessment]}</strong></p><Claim claim={report.taxonomy.reasoning}/>
      <p class="ir-small">This is the collection’s architectural analysis, not a new related-work survey. Benchmark comparisons and their protocols appear in Section 6.</p>
    </section>

    <section id="formulation" class="ir-section" data-report-section>
      <h2>4. Problem formulation</h2>
      <h3>4.1 Inputs and outputs</h3>
      <div class="ir-table-scroll" role="region" aria-label="Method inputs and outputs" tabindex="0"><table><thead><tr><th scope="col">Inputs</th><th scope="col">Outputs</th></tr></thead><tbody><tr><td><ul>{report.method.inputs.map(text => <li>{text}</li>)}</ul></td><td><ul>{report.method.outputs.map(text => <li>{text}</li>)}</ul></td></tr></tbody></table></div>
      {report.method.equations.length > 0 && <><h3>4.2 Equations and their role</h3>{report.method.equations.map(equation => <Equation {...equation}/>)}</>}
    </section>

    <section id="mechanism" class="ir-section" data-report-section>
      <h2>5. Method in detail</h2>
      {edition.walkthrough.map((step,index) => <div class="ir-walkthrough"><h3>5.{index + 1} {step.heading}</h3><Claim claim={{text:step.text,kind:step.kind,evidenceIds:step.evidenceIds}}/>{methodVisuals[index + 1] && <SourceVisual visual={methodVisuals[index + 1]}/>}</div>)}
      {methodVisuals.slice(edition.walkthrough.length + 1).map(visual => <SourceVisual visual={visual}/>)}
      <h3 id="execution">5.4 Training and inference</h3>
      <h4>During training</h4>{report.method.training.length ? report.method.training.map(claim => <Claim claim={claim}/>) : <p>This reading does not include a training procedure.</p>}
      <h4>During inference</h4>{report.method.inference.length ? report.method.inference.map(claim => <Claim claim={claim}/>) : <p>This reading does not include an inference procedure.</p>}
      <h3>5.5 Implementation flow</h3>
      <ol class="ir-implementation">{report.method.steps.map(step => <li><strong>{step.name}</strong><p>{step.detail} <EvidenceRefs ids={step.evidenceIds}/></p></li>)}</ol>
    </section>

    <section id="results" class="ir-section" data-report-section>
      <h2>6. Experiments & results</h2>
      <p>{plainSynopsis}</p>
      {edition.visualLimitations && <div class="ir-note"><strong>Source and visual limitations</strong><Claim claim={edition.visualLimitations}/></div>}
      <h3>6.1 Read the original evidence</h3>{resultVisuals.length ? resultVisuals.map(visual => <SourceVisual visual={visual}/>) : <p>No results visual is included in this edition. The source-specific visual limitations are recorded above.</p>}
      <h3>6.2 Results and evaluation conditions</h3>
      {report.results.length ? <div class="ir-table-scroll" role="region" aria-label="Results with settings and comparisons" tabindex="0"><table class="ir-results-table"><thead><tr><th scope="col">Task & protocol</th><th scope="col">Reported result</th><th scope="col">Comparison & interpretation</th></tr></thead><tbody>{report.results.map(result => <tr><td><strong>{result.task}</strong><p>{result.setting}</p></td><td><strong>{result.value}</strong><p>{result.metric}</p></td><td><p>{result.comparison}</p><p>{result.interpretation} <EvidenceRefs ids={result.evidenceIds}/></p></td></tr>)}</tbody></table></div> : <p>No quantitative results are included in this reading.</p>}
      <h3 id="ablation">6.3 Ablations and diagnostic examples</h3>
      {ablationVisuals.length ? <><p>Read component removals and qualitative examples within their stated evaluation conditions.</p>{ablationVisuals.map(visual => <SourceVisual visual={visual}/>)}</> : <p>No ablation or diagnostic visual is included in this edition. The source-specific visual limitations are recorded above.</p>}
    </section>

    <section id="boundaries" class="ir-section" data-report-section>
      <h2>7. Analysis & limitations</h2>
      <h3>7.1 What the evidence leaves open</h3>{report.limitations.map(claim => <Claim claim={claim}/>)}
      <h3>7.2 Questions for discussion</h3><ol>{report.discussionQuestions.map(question => <li>{question}</li>)}</ol>
    </section>

    <section id="evidence" class="ir-section" data-report-section>
      <h2>8. Reproducibility audit</h2>
      <h3>8.1 Requirements and known gaps</h3>{report.reproduction.map(claim => <Claim claim={claim}/>)}
      <h3>8.2 Proposed reproduction checks</h3><p>The following checks are proposals motivated by the paper. They have not been run as part of this reading.</p>
      {edition.reproductionChecks.map((check,index) => <div class="ir-audit-card"><h4>Check {index + 1}: {check.title}</h4><p>{check.text} <EvidenceRefs ids={check.evidenceIds}/></p></div>)}
      <h3 id="coverage">8.3 Reading coverage</h3><div class="ir-note"><p><strong>Visual audit:</strong> {edition.visualAudit.notes}</p><p>PDF pages inspected for this edition: {edition.visualAudit.inspectedPages.join(', ')}. Appendix coverage: {appendixLabel[report.coverage.appendix].toLowerCase()}.</p><p>Original figures and tables remain the work of the paper’s authors. Crops preserve their scientific content; the surrounding reading notes are our own.</p></div>
      <details class="ir-detail"><summary>Text reading scope & known omissions</summary><ul>{report.coverage.sectionsRead.map(section => <li>{section}</li>)}</ul><h4>Outside the original text pass</h4><ul>{report.coverage.omissions.map(omission => <li>{omission}</li>)}</ul><p>The visual audit above records the subsequent illustrated pass.</p></details>
      <h3>8.4 Traceable evidence</h3>
      <div class="rn-evidence-list">{report.evidence.map(evidence => <details class="rn-evidence" id={reportAnchor('evidence',evidence.id)}><summary><span>{evidence.id}</span><strong>{evidence.location}</strong><span class="rn-expand-label">Inspect</span></summary><div><p>{evidence.detail}</p><a href={`#${reportAnchor('source',evidence.sourceId)}`}>Go to primary source ↓</a></div></details>)}</div>
      <h3>8.5 Primary sources</h3><div class="ir-sources">{report.sources.map(source => <article id={reportAnchor('source',source.id)}><h4><a href={source.url}>{source.title} ↗</a></h4><p>{source.kind.toUpperCase()} · {source.wordCount.toLocaleString('en-US')} extracted words</p><details><summary>Source fingerprint</summary><code>{source.sha256}</code></details></article>)}</div>
    </section>

    <footer class="ir-end">
      <nav class="ir-page-navigation" aria-label="Reading report pages">
        {seriesIndex > 0 ? <a href={pathFor(`reports/${illustratedReports[seriesIndex - 1].paperId}/`)}>← {illustratedReports[seriesIndex - 1].shortTitle}</a> : <span/>}
        {seriesIndex < illustratedReports.length - 1 && <a href={pathFor(`reports/${illustratedReports[seriesIndex + 1].paperId}/`)}>{illustratedReports[seriesIndex + 1].shortTitle} →</a>}
      </nav>
      <p><a href={`${pathFor('reports/')}#illustrated`}>View all {illustratedReports.length} illustrated readings</a> · <a href={pathFor()}>Explore the library</a></p>
      <p class="ir-small">Awesome WAM · English reading reports · Private preview</p>
    </footer>
  </div>
  <dialog class="ir-lightbox" id="figure-viewer" aria-labelledby="figure-viewer-caption"><div class="ir-lightbox-bar"><div><p id="figure-viewer-caption"></p><span>Scroll across the image to inspect details. Press Esc to close.</span></div><button type="button" data-close-viewer aria-label="Close enlarged figure">Close ×</button></div><div class="ir-lightbox-scroll"><img id="figure-viewer-image" alt=""/></div></dialog>
</article>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('#figure-viewer');
  const enlarged = document.querySelector<HTMLImageElement>('#figure-viewer-image');
  const caption = document.querySelector<HTMLElement>('#figure-viewer-caption');
  let previousOverflow = '';
  document.querySelectorAll<HTMLButtonElement>('[data-enlarge-image]').forEach(button => button.addEventListener('click', () => {
    const img = button.querySelector('img');
    if (!viewer || !enlarged || !caption || !img) return;
    enlarged.src = img.currentSrc || img.src; enlarged.alt = img.alt;
    caption.textContent = button.dataset.imageCaption || '';
    previousOverflow = document.body.style.overflow; document.body.style.overflow = 'hidden';
    viewer.showModal();
  }));
  document.querySelector('[data-close-viewer]')?.addEventListener('click', () => viewer?.close());
  viewer?.addEventListener('close', () => { document.body.style.overflow = previousOverflow; });
  viewer?.addEventListener('click', event => { if (event.target === viewer) viewer.close(); });
</script>
