---
import { pathFor } from '../../lib/catalog';
import { siteName, siteShortName } from '../../lib/site.mjs';
import '../../styles/report-contents.css';

interface Props {
  sections: { id: string; label: string }[];
  currentShortTitle?: string;
}

const { sections, currentShortTitle } = Astro.props;
const contents = sections.map((section, index) => ({
  ...section,
  label: /^\d+[.)]\s/.test(section.label) ? section.label : `${index + 1}. ${section.label}`,
}));
---

<nav class="rc-contents" aria-label={currentShortTitle ? `${currentShortTitle}: contents` : 'Contents'}>
  <div class="rc-contents-heading">
    <a class="rc-home-marker" href={pathFor()} aria-label={`${siteName} home`}>{siteShortName}</a>
    <strong class="rc-contents-label">Contents</strong>
  </div>
  <ul class="rc-contents-list">
    {contents.map(section => <li class="rc-contents-item"><a class="rc-contents-link" href={`#${section.id}`} data-toc-link>{section.label}</a></li>)}
  </ul>
</nav>
