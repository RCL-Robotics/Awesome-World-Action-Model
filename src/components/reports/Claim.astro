---
import EvidenceRefs from './EvidenceRefs.astro';
import { claimKindLabel, type ReportClaim } from '../../lib/reports';
interface Props { claim: ReportClaim; }
const { claim } = Astro.props;
---
<div class="rn-claim" data-kind={claim.kind}>
  <span class="rn-claim-kind">{claimKindLabel[claim.kind]}</span>
  <p>{claim.text} <EvidenceRefs ids={claim.evidenceIds}/></p>
</div>
