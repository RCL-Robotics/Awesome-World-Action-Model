---
import { readingEntryFor, readingStatusLabel, reportPath } from '../../lib/reports';
import { pathFor } from '../../lib/catalog';
import Icon from '../Icon.astro';
interface Props { paperId: string; }
const { paperId } = Astro.props;
const entry = readingEntryFor(paperId);
---
{entry && <aside class="reading-cta" aria-label="Reading report">
  <div><span class="reading-cta-label">RESEARCH NOTE · {readingStatusLabel[entry.readingStatus]}</span><h2>{entry.report ? 'Reading report' : 'Reading status'}</h2><p>{entry.report ? `${entry.report.readingTimeMinutes} min read · Source scope and evidence locations included.` : 'Reading coverage is tracked separately from catalog metadata.'}</p></div>
  <a href={entry.report ? reportPath(paperId) : `${pathFor('reports/')}?q=${encodeURIComponent(paperId)}#queue`}>{entry.report ? 'Read the report' : 'View reading status'} <Icon name="arrow" size={15}/></a>
</aside>}
<style>
  @layer components {
  .reading-cta { display: flex; align-items: center; justify-content: space-between; gap: 24px; border: 1px solid #d4e1eb; border-radius: 6px; padding: 21px 24px; background: linear-gradient(110deg, #edf3f8, #f5f8fb); margin: 0 0 31px; }
  .reading-cta-label { color: #8299ac; font-size: calc(8px * var(--font-scale)); letter-spacing: .1em; text-transform: uppercase; }
  .reading-cta h2 { color: #4b6f8c; font-size: calc(15px * var(--font-scale)); font-weight: 500; margin-block: 7px; letter-spacing: -.01em; }
  .reading-cta p { color: #879bad; font-size: calc(10px * var(--font-scale)); }
  .reading-cta > a { display: flex; align-items: center; gap: 9px; color: #577d9c; font-size: calc(11px * var(--font-scale)); white-space: nowrap; border: 1px solid #c9dae7; border-radius: 4px; padding: 10px 14px; background: white; }
  .reading-cta > a:hover { border-color: #93b0c7; color: #355e80; }
  @media (max-width: 560px) { .reading-cta { flex-direction: column; align-items: flex-start; gap: 15px; padding: 19px; } .reading-cta h2 { font-size: calc(14px * var(--font-scale)); } }
  @media print { .reading-cta { display: none; } }
  }
</style>
