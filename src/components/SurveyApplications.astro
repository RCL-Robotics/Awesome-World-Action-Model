---
import SurveySection from './SurveySection.astro';

const section = {
  "id": "applications",
  "title": "Applications",
  "intro": "WAMs are used differently across embodied domains. Their value may lie in representation learning before policy training, in imagined look-ahead during inference, or in synthetic trajectories used for policy improvement. We therefore organize this section by application domain, including robot manipulation, navigation, and autonomous driving, and examine the role that prediction plays in each domain.",
  "figures": [
    {
      "image": "survey-assets/wam-applications.webp",
      "pdf": "survey-assets/wam-applications.pdf",
      "width": 3600,
      "height": 2348,
      "alt": "Application summary table, grouped into robot manipulation, navigation, and autonomous driving, listing methods, paradigms, backbones, and evaluation notes.",
      "title": "Application summary",
      "caption": "Methods are grouped by domain, with their paradigms, backbones, and evaluation notes."
    }
  ]
};
---

<SurveySection {...section} />
