---
import Icon from './Icon.astro';
import FontSizeToggle from './FontSizeToggle.astro';
import { pathFor, repoUrl } from '../lib/catalog';
interface Props { active?: string; }
const { active = 'explore' } = Astro.props;
---
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={pathFor()} aria-label="Awesome World Action Model home">
          <svg viewBox="0 0 36 36" class="brand-mark" fill="none" aria-hidden="true"><path d="m18 3 13 7.5v15L18 33 5 25.5v-15L18 3Z" stroke="currentColor" stroke-width="1.5"/><path d="m5 10.5 13 8 13-8M18 18.5V33M11.5 7l13 7.5v15" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="18.5" r="3" fill="#7fa8ca" stroke="#f8fafc" stroke-width="2"/></svg>
          <span>AWESOME <b>WAM</b><small>WORLD ACTION MODELS</small></span>
        </a>
        <nav aria-label="Main navigation">
          <a class:list={{ active: active === 'explore' }} href={pathFor()}>Explore</a>
          <a class:list={{ active: active === 'map' }} href={pathFor('map/')}>Research map</a>
          <a class:list={{ active: active === 'reports' }} href={pathFor('reports/')}>Reading reports</a>
          <a class:list={{ active: active === 'about' }} href={pathFor('about/')}>About</a>
        </nav>
        <div class="header-actions">
          <FontSizeToggle />
          <a class="github-link" href={repoUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub repository"><Icon name="github" size={17} /><span>GitHub</span><Icon name="arrow" size={14} /></a>
        </div>
      </div>
    </header>

<style>
  .header-actions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .header-inner nav a { white-space: nowrap; }
  @media (max-width: 1100px) and (min-width: 801px) {
    .header-inner { gap: 16px; }
    .header-inner nav { gap: 20px; }
    .github-link { padding: 8px; }
    .github-link span, .github-link :global(svg:last-child) { display: none; }
  }
  @media (max-width: 700px) {
    .header-inner { flex-wrap: wrap; gap: 0; padding-top: 17px; }
    .brand { flex: 1; }
    .header-inner nav { order: 3; width: 100%; height: auto; min-height: 49px; justify-content: center; margin-top: 6px; }
    .header-inner nav a { padding-block: 15px; }
    .header-actions { gap: 8px; }
  }
  @media (max-width: 800px) { .header-inner nav { gap: 16px; } .header-inner nav a { font-size: calc(11px * var(--font-scale)); } }
  @media (max-width: 560px) { .header-inner nav { gap: clamp(12px, 4vw, 24px); } .header-inner nav a { font-size: calc(10px * var(--font-scale)); } }
</style>
