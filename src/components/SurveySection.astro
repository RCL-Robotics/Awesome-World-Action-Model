---
import { pathFor } from '../lib/catalog';

interface Figure {
  image: string;
  pdf: string;
  width: number;
  height: number;
  alt: string;
  title: string;
  caption: string;
  eager?: boolean;
}

interface Props {
  id: string;
  title: string;
  intro: string;
  figures: Figure[];
}

const { id, title, intro, figures } = Astro.props;
---

<section id={id} class="home-section home-topic" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{title}</h2>
  <div class="home-topic-intro"><p>{intro}</p></div>
  {figures.map((figure) => (
    <figure class="home-source-figure">
      <a class="home-figure-image" href={pathFor(figure.pdf)} target="_blank" rel="noopener noreferrer" aria-label={`Open ${figure.title} as a PDF`}>
        <img src={pathFor(figure.image)} width={figure.width} height={figure.height} loading={figure.eager ? 'eager' : 'lazy'} fetchpriority={figure.eager ? 'high' : undefined} decoding="async" alt={figure.alt}/>
      </a>
      <figcaption><strong>{figure.title}.</strong> {figure.caption}</figcaption>
    </figure>
  ))}
</section>
