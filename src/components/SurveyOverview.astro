---
import Icon from './Icon.astro';
import SurveyAuthors from './SurveyAuthors.astro';
import SurveyAbstract from './SurveyAbstract.astro';
import SurveySection from './SurveySection.astro';
import { pathFor, repoUrl } from '../lib/catalog';
import { siteName } from '../lib/site.mjs';

const overview = {
  "id": "overview",
  "title": "Overview",
  "intro": "World-Action Models (WAMs) connect future-state modeling with executable action generation to support predictive robot control. World models learn how the environment evolves, often conditioned on actions; VLA policies map observations and language to actions. In our survey, WAMs connect these capabilities within a shared learning or inference process, so action generation is informed by predicted consequences.",
  "figures": [
    {
      "image": "survey-assets/wam-components.webp",
      "pdf": "survey-assets/wam-components.pdf",
      "width": 3000,
      "height": 1330,
      "eager": true,
      "alt": "Components of WAMs: language and visual encoders condition a predictive backbone, which connects world prediction and action decoding to robot execution.",
      "title": "Component view",
      "caption": "Language provides task conditioning, the visual encoder defines the predictive state, the backbone models dynamics, and the action decoder produces executable controls."
    }
  ]
};
const architecture = {
  "id": "architecture",
  "title": "Architecture",
  "intro": "We categorize WAMs along two independent axes: architecture and transition modeling. One Model uses a shared backbone, while Dual-system separates world and action experts. Joint prediction couples future observation and action generation; inverse dynamics (IDM) predicts future states and then infers executable actions. Some IDM-style systems learn this interface implicitly and decode actions without explicitly generating a full future rollout at inference.",
  "figures": [
    {
      "image": "survey-assets/wam-architectures.webp",
      "pdf": "survey-assets/wam-architectures.pdf",
      "width": 3000,
      "height": 612,
      "alt": "Four architectures of WAMs: a unified backbone with joint prediction, a unified backbone with inverse dynamics, dual experts with joint prediction, and dual experts with inverse dynamics.",
      "title": "Architecture taxonomy",
      "caption": "(a) One Model + joint prediction; (b) One Model + IDM; (c) Dual-system + joint prediction; (d) Dual-system + IDM."
    }
  ]
};
---

<div class="survey-introduction">
  <header class="survey-title-block">
    <p class="survey-kicker">PREDICT THE WORLD. CONNECT TO ACTION.</p>
    <h1>{siteName}<span>for Robot Learning and Control: A Survey</span></h1>
    <p class="survey-subtitle">A robotics-oriented review of models that connect future world prediction<br class="desktop-break"/> with executable action generation.</p>
    <SurveyAuthors/>
    <nav class="survey-links" aria-label="Survey resources">
      <a href={pathFor('papers/')}><Icon name="book" size={17}/> Paper library</a>
      <a href={pathFor('map/?mode=quadrants')}><Icon name="grid" size={17}/> Research map</a>
      <a href={pathFor('reports/')}><Icon name="list" size={17}/> Reading reports</a>
      <a href={repoUrl} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17}/> GitHub</a>
    </nav>
  </header>

  <SurveyAbstract />
  <SurveySection {...overview} />
  <SurveySection {...architecture} />
</div>

<style>
  .survey-introduction { background: #fff; color: #30363d; }
  .survey-title-block { width: min(1120px, calc(100% - 96px)); margin-inline: auto; }
  .survey-title-block { padding-block: 53px 39px; text-align: center; }
  .survey-kicker { margin: 0 0 19px; color: #64768a; font-size: calc(10px * var(--font-scale)); font-weight: 650; letter-spacing: .16em; }
  h1 { margin: 0; color: #2f343b; font-family: var(--font-sans); font-size: clamp(35px, 4.1vw, calc(48px * var(--font-scale))); font-weight: 720; line-height: 1.15; letter-spacing: -.035em; text-wrap: balance; }
  h1 span { display: block; margin-top: 12px; font-size: .64em; font-weight: 600; line-height: 1.3; letter-spacing: -.025em; }
  .survey-subtitle { margin: 22px auto 0; color: #68717d; font-size: calc(14px * var(--font-scale)); line-height: 1.7; text-wrap: pretty; }
  .survey-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 9px; margin-top: 25px; }
  .survey-links a { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 41px; padding: 9px 17px; border: 1px solid #363d46; border-radius: 999px; background: #363d46; color: #fff; font-size: calc(11px * var(--font-scale)); font-weight: 550; line-height: 1.35; text-decoration: none; transition: background .15s ease; }
  .survey-links a:hover { background: #4d627a; border-color: #4d627a; }
  a:focus-visible { outline: 3px solid #5286ae; outline-offset: 5px; }
  @media (max-width: 760px) {
    .survey-title-block { width: calc(100% - 40px); }
    .survey-title-block { padding-block: 35px 30px; }
    .survey-kicker { font-size: 9px; letter-spacing: .11em; }
    h1 { font-size: clamp(30px, 6.5vw, 43px); }
    h1 span { max-width: 560px; margin-inline: auto; font-size: .64em; }
    .survey-subtitle { max-width: 540px; margin-top: 20px; font-size: calc(12px * var(--font-scale)); }
    .desktop-break { display: none; }
    .survey-links { gap: 8px; margin-top: 22px; }
    .survey-links a { min-height: 40px; padding: 9px 13px; font-size: calc(10px * var(--font-scale)); }
  }
  @media (prefers-reduced-motion: reduce) { .survey-links a { transition: none; } }
</style>
