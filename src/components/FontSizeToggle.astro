<div class="font-size-toggle" role="group" aria-label="Text size" hidden>
  <button type="button" data-font-size="small" aria-label="Small text" aria-pressed="false" title="Small text (original size)"><span aria-hidden="true">A</span></button>
  <button type="button" data-font-size="large" aria-label="Large text" aria-pressed="true" title="Large text (default)"><span aria-hidden="true">A</span></button>
</div>

<script>
  const controls = document.querySelector<HTMLElement>('.font-size-toggle');
  if (controls) {
    const buttons = controls.querySelectorAll<HTMLButtonElement>('button[data-font-size]');
    const applySize = (size: string | null | undefined) => {
      const selected = size === 'small' ? 'small' : 'large';
      document.documentElement.dataset.fontSize = selected;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.fontSize === selected)));
    };

    applySize(document.documentElement.dataset.fontSize);
    controls.hidden = false;
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const size = button.dataset.fontSize === 'small' ? 'small' : 'large';
        applySize(size);
        try {
          localStorage.setItem('wam-font-size', size);
        } catch {
          // The control still works when browser storage is unavailable.
        }
      });
    });
    window.addEventListener('storage', (event) => {
      if (event.key === 'wam-font-size' || event.key === null) applySize(event.newValue);
    });
    window.addEventListener('pageshow', () => {
      try {
        applySize(localStorage.getItem('wam-font-size'));
      } catch {
        // Keep the current selection when browser storage is unavailable.
      }
    });
  }
</script>

<style>
  .font-size-toggle { display: inline-flex; align-items: center; gap: 2px; padding: 3px; border: 1px solid #d5dfe7; border-radius: 5px; }
  button { display: grid; place-items: center; min-width: 32px; min-height: 32px; padding: 2px 7px; border: 0; border-radius: 3px; background: transparent; color: var(--muted); font-weight: 600; line-height: 1; }
  button[data-font-size='small'] { font-size: calc(12px * var(--font-scale)); }
  button[data-font-size='large'] { font-size: calc(16px * var(--font-scale)); }
  button:hover { background: var(--soft); color: var(--navy); }
  button[aria-pressed='true'] { background: var(--navy); color: white; }
</style>
