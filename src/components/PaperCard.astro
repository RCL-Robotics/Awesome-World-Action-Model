---
import { majorCategoryFor, quadrantFor, pathFor, paperPath, paperSourceUrl, type Paper } from '../lib/catalog';
import Icon from './Icon.astro';
import PaperDate from './PaperDate.astro';
import { taxonomyLabel } from '../lib/taxonomy.mjs';
interface Props { paper: Paper; index: number; }
const { paper, index } = Astro.props;
const majorCategory = majorCategoryFor(paper.majorCategory);
const quadrant = quadrantFor(paper.quadrant);
const authors = paper.authors.split(';').map(s => s.trim());
const authorLine = authors.length > 3 ? `${authors.slice(0, 3).join('; ')} +${authors.length - 3} authors` : paper.authors;
---
<article class="paper-card" data-paper-id={paper.id}>
  <span class="paper-index" aria-hidden="true">{String(index + 1).padStart(3, '0')}</span>
  <div class="paper-main">
    <div class="paper-meta"><div class="paper-taxonomy"><a class="category-tag" href={`${pathFor()}?major=${encodeURIComponent(paper.majorCategory || '__unassigned__')}#library`} data-major={paper.majorCategory || '__unassigned__'} style={`--category-color:${majorCategory?.color || '#8b96a1'}`} aria-label={`Major category: ${taxonomyLabel(paper.majorCategory)}`}><span></span>{majorCategory?.label || 'Not assigned'}</a>{paper.quadrant && <a class="quadrant-tag" href={`${pathFor()}?quadrant=${encodeURIComponent(paper.quadrant)}#library`} data-quadrant={paper.quadrant} title={taxonomyLabel(paper.quadrant)} aria-label={`Quadrant: ${taxonomyLabel(paper.quadrant)}`} style={`--quadrant-color:${quadrant?.color || '#8b96a1'}`}>{quadrant?.label || taxonomyLabel(paper.quadrant)}</a>}</div><PaperDate paper={paper}/></div>
    <h3><a href={paperPath(paper.id)}>{paper.title}</a></h3>
    <p class="paper-authors">{authorLine || 'Authors not listed'}</p>
    <p class="paper-contribution">{paper.contribution || 'Contribution summary not yet recorded.'}</p>
    <div class="paper-bottom">
      <div class="paper-actions"><a href={paper.arxivUrl || paperSourceUrl(paper)} target="_blank" rel="noopener noreferrer">{paper.arxivUrl ? 'arXiv' : 'Paper'} <Icon name="arrow" size={13}/></a>{paper.pdfUrl && <a href={paper.pdfUrl} target="_blank" rel="noopener noreferrer">PDF <Icon name="arrow" size={13}/></a>}{paper.doi && <a href={paper.doi} target="_blank" rel="noopener noreferrer">DOI <Icon name="arrow" size={13}/></a>}{paper.codeUrls.length > 0 && <a href={paper.codeUrls[0]} target="_blank" rel="noopener noreferrer"><Icon name="code" size={14}/> Code</a>}{paper.projectUrl && <a href={paper.projectUrl} target="_blank" rel="noopener noreferrer">Project <Icon name="arrow" size={13}/></a>}</div>
      <a class="details-link" href={paperPath(paper.id)}>View paper <Icon name="right" size={15}/></a>
    </div>
  </div>
</article>
