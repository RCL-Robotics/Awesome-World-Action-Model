---
import { categoryFor, paperPath, formatDate, type Paper } from '../lib/catalog';
import Icon from './Icon.astro';
interface Props { paper: Paper; index: number; }
const { paper, index } = Astro.props;
const category = categoryFor(paper.primaryCategory);
const authors = paper.authors.split(';').map(s => s.trim());
const authorLine = authors.length > 3 ? `${authors.slice(0, 3).join('; ')} +${authors.length - 3} authors` : paper.authors;
---
<article class="paper-card" data-paper-id={paper.id}>
  <span class="paper-index" aria-hidden="true">{String(index + 1).padStart(3, '0')}</span>
  <div class="paper-main">
    <div class="paper-meta"><span class="category-tag" style={`--category-color:${category?.color || '#65798e'}`}><span></span>{category?.label || paper.primaryCategory}</span><time datetime={paper.submittedDate}>{formatDate(paper.submittedDate)}</time></div>
    <h3><a href={paperPath(paper.id)}>{paper.title}</a></h3>
    <p class="paper-authors">{authorLine}</p>
    <p class="paper-contribution">{paper.contribution}</p>
    <div class="paper-bottom">
      <div class="paper-actions"><a href={paper.arxivUrl} target="_blank" rel="noopener noreferrer">arXiv <Icon name="arrow" size={13}/></a>{paper.codeUrls.length > 0 && <a href={paper.codeUrls[0]} target="_blank" rel="noopener noreferrer"><Icon name="code" size={14}/> Code</a>}{paper.projectUrl && <a href={paper.projectUrl} target="_blank" rel="noopener noreferrer">Project <Icon name="arrow" size={13}/></a>}</div>
      <a class="details-link" href={paperPath(paper.id)}>View paper <Icon name="right" size={15}/></a>
    </div>
  </div>
</article>
