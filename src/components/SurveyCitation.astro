---
import Icon from './Icon.astro';
import { repoUrl } from '../lib/catalog';
import { surveyAuthors, surveyTitle, surveyYear } from '../lib/survey.mjs';

// Cite the public project until the repository provides a formal paper reference.
const authorLines = surveyAuthors.reduce<string[]>((lines, author, index) => {
  if (index % 4 === 0) lines.push(author.name);
  else lines[lines.length - 1] += ` and ${author.name}`;
  return lines;
}, []);
const bibtex = `@misc{lu2026worldactionmodels,
  title        = {{${surveyTitle}}},
  author       = {${authorLines.join(' and\n                  ')}},
  year         = {${surveyYear}},
  howpublished = {Project website and paper collection},
  url          = {${repoUrl}}
}`;
---

<section id="citation" class="survey-citation" aria-labelledby="citation-heading">
  <h2 id="citation-heading">Citation</h2>
  <p class="citation-intro">If you find our survey or WAMs resources useful in your research, please cite this project.</p>
  <div class="citation-box">
    <div class="citation-toolbar">
      <label for="survey-bibtex">BibTeX</label>
      <button id="copy-survey-citation" type="button"><Icon name="copy" size={15}/><span>Copy BibTeX</span></button>
    </div>
    <textarea id="survey-bibtex" aria-label="Project citation in BibTeX format" readonly spellcheck="false" rows={bibtex.split('\n').length}>{bibtex}</textarea>
  </div>
  <div class="citation-details">
    <p>Project citation. The paper’s arXiv reference will be added when available.</p>
    <p id="survey-citation-status" role="status" aria-live="polite"></p>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-survey-citation');
  const citation = document.querySelector<HTMLTextAreaElement>('#survey-bibtex');
  const status = document.querySelector<HTMLElement>('#survey-citation-status');
  button?.addEventListener('click', async () => {
    if (!citation || !status) return;
    try {
      await navigator.clipboard.writeText(citation.value);
      status.textContent = 'BibTeX copied.';
    } catch {
      citation.focus();
      citation.select();
      status.textContent = 'Text selected. Press Ctrl+C or ⌘C to copy.';
    }
  });
</script>

<style>
  .survey-citation { width: min(1120px, calc(100% - 96px)); margin-inline: auto; padding-block: 38px 40px; color: #30363d; scroll-margin-top: 100px; }
  h2 { margin: 0; font-size: calc(25px * var(--font-scale)); font-weight: 650; line-height: 1.3; letter-spacing: -.025em; text-align: center; }
  .citation-intro { margin: 16px auto 25px; color: #626d79; font-size: calc(12px * var(--font-scale)); line-height: 1.75; text-align: center; }
  .citation-box { border: 1px solid #dce1e6; border-radius: 3px; background: #f7f8f9; overflow: hidden; }
  .citation-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 18px; border-bottom: 1px solid #e2e5e8; background: #fff; }
  .citation-toolbar label { color: #4e5964; font-size: calc(11px * var(--font-scale)); font-weight: 600; }
  button { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid #cbd3db; border-radius: 2px; background: #fff; color: #24588a; font: inherit; font-size: calc(10px * var(--font-scale)); cursor: pointer; }
  button:hover { background: #f0f4f7; }
  textarea { display: block; width: 100%; max-width: 100%; min-height: 230px; padding: 18px; border: 0; border-radius: 0; resize: vertical; background: transparent; color: #39444f; font: calc(11px * var(--font-scale))/1.75 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre; overflow: auto; }
  textarea:focus-visible { outline: 2px solid #24588a; outline-offset: -3px; }
  .citation-details { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 20px; margin-top: 12px; color: #737d87; font-size: calc(10px * var(--font-scale)); line-height: 1.7; }
  .citation-details p { margin: 0; }
  #survey-citation-status { color: #24588a; }
  @media (max-width: 760px) {
    .survey-citation { width: calc(100% - 40px); padding-block: 29px 32px; }
    h2 { font-size: calc(22px * var(--font-scale)); }
    .citation-intro { margin-bottom: 21px; font-size: calc(11px * var(--font-scale)); }
    .citation-toolbar { padding: 10px 12px; }
    textarea { padding: 14px 12px; font-size: calc(10px * var(--font-scale)); }
  }
</style>
