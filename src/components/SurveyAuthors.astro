---
import { surveyAuthors as authors, surveyAffiliations as affiliations } from '../lib/survey.mjs';
---

<section class="survey-authors" aria-label="Survey authors and affiliations">
  <p class="author-names">
    {authors.map((author, index) => <><span class="author-name">{author.name}<sup>{author.mark}</sup>{index < authors.length - 1 ? ',' : ''}</span>{' '}</>)}
  </p>
  <p class="author-affiliations">
    {affiliations.map((affiliation, index) => <><span class="author-affiliation"><sup>{index + 1}</sup> {affiliation}</span>{index < affiliations.length - 1 && <span class="affiliation-separator" aria-hidden="true"> · </span>}</>)}
  </p>
  <p class="author-notes"><span><sup>*</sup> Equal contribution</span><span aria-hidden="true"> · </span><span><sup>†</sup> Corresponding author</span></p>
</section>

<style>
  .survey-authors { max-width: 870px; margin: 26px auto 0; text-align: center; }
  .author-names { margin: 0; color: #39434e; font-size: calc(14px * var(--font-scale)); line-height: 2; text-wrap: balance; }
  .author-name { display: inline-block; white-space: nowrap; }
  sup { position: relative; top: -.4em; margin-left: 2px; font-size: .7em; line-height: 0; vertical-align: baseline; }
  .author-affiliations { max-width: 760px; margin: 13px auto 0; color: #626d79; font-size: calc(11px * var(--font-scale)); line-height: 1.9; text-wrap: balance; }
  .author-affiliation { display: inline-block; white-space: nowrap; }
  .affiliation-separator { color: #8b949e; }
  .author-notes { margin: 9px 0 0; color: #737d87; font-size: calc(10px * var(--font-scale)); line-height: 1.8; }
  .author-notes span { display: inline-block; }
  @media (max-width: 760px) {
    .survey-authors { margin-top: 22px; }
    .author-names { font-size: calc(12px * var(--font-scale)); line-height: 1.95; }
    .author-affiliations { margin-top: 12px; font-size: calc(10px * var(--font-scale)); }
    .author-notes { font-size: calc(9px * var(--font-scale)); }
  }
</style>
