{
  "name": "awesome-world-action-model",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run validate:data && npm run validate:reports && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "sync:notion": "node scripts/sync-notion.mjs",
    "generate:readme": "node scripts/generate-readme.mjs",
    "validate:reports": "node scripts/validate-reports.mjs",
    "reading:index": "node scripts/reading/update-index.mjs",
    "reading:run": "node scripts/reading/run-reports.mjs",
    "reading:status": "node scripts/reading/status.mjs",
    "reading:illustrated": "node scripts/reading/run-illustrated.mjs",
    "reading:illustrated:status": "node scripts/reading/run-illustrated.mjs --status"
  },
  "dependencies": {
    "astro": "7.3.1",
    "katex": "^0.18.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/katex": "^0.16.8",
    "typescript": "5.9.3"
  }
}
